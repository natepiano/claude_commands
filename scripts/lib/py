#!/usr/bin/env bash
# Find a python3 new enough for this repo, then exec it with our arguments.
#
# This repo uses match statements and `X | Y` unions, so it needs Python >= 3.10
# (30 files would fail on less). On macOS the `python3` on PATH is Apple's
# /usr/bin/python3, which is 3.9 -- which is why the hooks used to hardcode
# /opt/homebrew/bin/python3. That path does not exist on Linux, so every hook
# silently failed there. Choosing by VERSION rather than by path works on both.
#
# Order: explicit override first, then PATH -- correct on NixOS, and on a Mac
# whose PATH puts homebrew ahead of /usr/bin -- then the nix-darwin system and
# per-user profiles (a session started before nix reached PATH still finds
# them), then homebrew's usual locations for a Mac whose PATH does not.
#
# Resolution costs a python3 spawn per candidate tried, and the hooks come
# through here several times a second -- the prioritize watcher alone accounted
# for ~100 a minute, every one re-asking a question whose answer cannot change
# while the interpreter stays put. So the winner is remembered by absolute path
# and revalidated with a stat instead. A garbage-collected nix store path, or a
# homebrew python that has been uninstalled, fails -x and falls through to a
# full resolution; the cache key carries the version floor, so raising
# NEED_MINOR invalidates it. CLAUDE_PYTHON is an explicit override and skips
# the cache in both directions.
set -uo pipefail

NEED_MAJOR=3
NEED_MINOR=10

if [[ -n "${XDG_CACHE_HOME:-}" ]]; then
    cache_dir="$XDG_CACHE_HOME/claude"
elif [[ ${OSTYPE:-} == darwin* ]]; then
    cache_dir="$HOME/Library/Caches/claude"
else
    cache_dir="$HOME/.cache/claude"
fi
cache_file="$cache_dir/python3-$NEED_MAJOR.$NEED_MINOR"

if [[ -z "${CLAUDE_PYTHON:-}" && -r "$cache_file" ]]; then
    read -r cached < "$cache_file" || cached=""
    if [[ -n "$cached" && -x "$cached" ]]; then
        exec "$cached" "$@"
    fi
fi

new_enough() {
    command -v "$1" >/dev/null 2>&1 || [ -x "$1" ] || return 1
    "$1" -c "import sys; sys.exit(0 if sys.version_info >= ($NEED_MAJOR, $NEED_MINOR) else 1)" 2>/dev/null
}

# Written through a temp file and renamed, so two hooks resolving at once can
# never leave a reader half a path.
remember() {
    local resolved="$1"
    [[ -n "${CLAUDE_PYTHON:-}" ]] && return 0
    [[ "$resolved" == /* ]] || return 0
    mkdir -p "$cache_dir" 2>/dev/null || return 0
    if printf '%s\n' "$resolved" > "$cache_file.$$" 2>/dev/null; then
        mv -f "$cache_file.$$" "$cache_file" 2>/dev/null || rm -f "$cache_file.$$" 2>/dev/null
    else
        rm -f "$cache_file.$$" 2>/dev/null
    fi
    return 0
}

for candidate in "${CLAUDE_PYTHON:-}" python3 \
    /run/current-system/sw/bin/python3 "/etc/profiles/per-user/${USER:-}/bin/python3" \
    /opt/homebrew/bin/python3 /usr/local/bin/python3; do
    [ -n "$candidate" ] || continue
    if new_enough "$candidate"; then
        resolved="$(command -v "$candidate" 2>/dev/null)" || resolved="$candidate"
        [ -n "$resolved" ] || resolved="$candidate"
        remember "$resolved"
        exec "$resolved" "$@"
    fi
done

echo "claude_commands: no python3 >= $NEED_MAJOR.$NEED_MINOR found (tried PATH and homebrew)." >&2
echo "Set CLAUDE_PYTHON to one, or install a newer python3." >&2
exit 127
