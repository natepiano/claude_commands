#!/usr/bin/env bash
# Select Python 3.12 or newer. Cache its absolute path unless CLAUDE_PYTHON is set.
# Set the package root without another process or a working directory change.
set -uo pipefail

shim="${BASH_SOURCE[0]}"
[[ "$shim" == /* ]] || shim="$PWD/$shim"
# Normalize parent segments without a process or a directory change.
IFS=/ read -r -a shim_parts <<< "$shim"
shim=""
for part in "${shim_parts[@]}"; do
    case "$part" in
        ''|.) ;;
        ..) shim="${shim%/*}" ;;
        *) shim="$shim/$part" ;;
    esac
done
root="${shim%/*/*/*}"

NEED_MAJOR=3
NEED_MINOR=12

python_options=()
file_separator=()
mode=stdin
target=""
if [[ "${1:-}" == --isolated ]]; then
    python_options+=(-I)
    shift
fi
while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|-m)
            mode="${1#-}"
            if [[ $# -lt 2 ]]; then
                echo "Argument expected for the $1 option" >&2
                exit 2
            fi
            target="$2"
            shift 2
            break ;;
        -c*|-m*) mode="${1:1:1}"; target="${1:2}"; shift; break ;;
        -) target=-; shift; break ;;
        --)
            file_separator=(--)
            shift
            if [[ $# -gt 0 ]]; then mode=file; target="$1"; shift; fi
            break ;;
        -W|-X|--check-hash-based-pycs)
            python_options+=("$1")
            shift
            if [[ $# -gt 0 ]]; then python_options+=("$1"); shift; fi ;;
        -*) python_options+=("$1"); shift ;;
        *) mode=file; target="$1"; shift; break ;;
    esac
done
# Add the root to this interpreter only. Keep native interpreter options.
bootstrap='
def launch():
    import os, sys
    root, mode, target = sys.argv[1:4]
    arguments = sys.argv[4:]
    import runpy
    sys.argv = [target if mode in {"file", "m"} else "-c", *arguments]
    runpy.run_path(os.path.join(root, "scripts/lib/python_startup/sitecustomize.py"), run_name="_shim_python_startup")["start_process"](sys.argv)
    namespace = sys.modules["__main__"].__dict__
    builtins = namespace["__builtins__"]
    namespace.clear()
    namespace.update(__name__="__main__", __package__=None, __spec__=None,
                     __builtins__=builtins)
    if mode == "m":
        import runpy
        sys.argv = [target, *arguments]
        runpy._run_module_as_main(target)
    elif mode == "file":
        import runpy
        if not sys.flags.isolated:
            sys.path.insert(0, os.path.dirname(os.path.abspath(target)))
        sys.argv = [target, *arguments]
        namespace.update(runpy.run_path(target, run_name="__main__"))
    else:
        sys.argv = ["-c" if mode == "c" else target, *arguments]
        if mode == "c":
            exec(compile(target, "<string>", "exec"), namespace)
        elif sys.stdin.isatty():
            if not sys.flags.interactive:
                import code
                code.interact(local=namespace)
        else:
            exec(compile(sys.stdin.read(), "<stdin>", "exec"), namespace)
launch()
'
startup="$root/scripts/lib/python_startup"
native=1
for option in "${python_options[@]}"; do
    case "$option" in
        --*|-W*|-X*) ;;
        -*I*|-*E*|-*S*) native=0 ;;
    esac
done
if [[ "$native" == 1 ]]; then
    export PYTHONPATH="$startup${PYTHONPATH+:$PYTHONPATH}"
    case "$mode" in
        c|m) set -- "${python_options[@]}" -P "-$mode" "$target" "$@" ;;
        file) set -- "${python_options[@]}" "${file_separator[@]}" "$target" "$@" ;;
        *)
            if [[ "$target" == - ]]; then
                set -- "${python_options[@]}" -P - "$@"
            else
                set -- "${python_options[@]}" -P "$@"
            fi ;;
    esac
else
    set -- "${python_options[@]}" -P -c "$bootstrap" "$root" "$mode" "$target" "$@"
fi

if [[ -n "${XDG_CACHE_HOME:-}" ]]; then
    cache_dir="$XDG_CACHE_HOME/claude"
elif [[ ${OSTYPE:-} == darwin* ]]; then
    cache_dir="$HOME/Library/Caches/claude"
else
    cache_dir="$HOME/.cache/claude"
fi
cache_file="$cache_dir/python3-$NEED_MAJOR.$NEED_MINOR"

if [[ -z "${CLAUDE_PYTHON:-}" && -r "$cache_file" ]]; then
    read -r cached < "$cache_file" || cached=""
    if [[ -n "$cached" && -x "$cached" ]]; then
        exec "$cached" "$@"
    fi
fi

new_enough() {
    command -v "$1" >/dev/null 2>&1 || [ -x "$1" ] || return 1
    "$1" -I -c "import sys; sys.exit(0 if sys.version_info >= ($NEED_MAJOR, $NEED_MINOR) else 1)" 2>/dev/null
}

# Written through a temp file and renamed, so two hooks resolving at once can
# never leave a reader half a path.
remember() {
    local resolved="$1"
    [[ -n "${CLAUDE_PYTHON:-}" ]] && return 0
    [[ "$resolved" == /* ]] || return 0
    mkdir -p "$cache_dir" 2>/dev/null || return 0
    if printf '%s\n' "$resolved" > "$cache_file.$$" 2>/dev/null; then
        mv -f "$cache_file.$$" "$cache_file" 2>/dev/null || rm -f "$cache_file.$$" 2>/dev/null
    else
        rm -f "$cache_file.$$" 2>/dev/null
    fi
    return 0
}

for candidate in "${CLAUDE_PYTHON:-}" python3 \
    /run/current-system/sw/bin/python3 "/etc/profiles/per-user/${USER:-}/bin/python3" \
    /opt/homebrew/bin/python3 /usr/local/bin/python3; do
    [ -n "$candidate" ] || continue
    if new_enough "$candidate"; then
        resolved="$(command -v "$candidate" 2>/dev/null)" || resolved="$candidate"
        [ -n "$resolved" ] || resolved="$candidate"
        remember "$resolved"
        exec "$resolved" "$@"
    fi
done

echo "claude_commands: no python3 >= $NEED_MAJOR.$NEED_MINOR found (tried PATH and homebrew)." >&2
echo "Set CLAUDE_PYTHON to one, or install a newer python3." >&2
exit 127
