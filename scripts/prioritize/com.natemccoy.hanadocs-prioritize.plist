<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.natemccoy.hanadocs-prioritize</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/natemccoy/.claude/scripts/prioritize/run_watcher.sh</string>
        <string>--daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>1</integer>
    <!-- ProcessType MUST NOT be Background. Background puts the job in the
         DARWIN_BG band, which forces an I/O throttle delay on every write.
         A top-of-backlog insert renumbers ~330 issue files; measured on this
         machine that is 0.5s at Standard and 38-47s under Background. The
         delay is per-write, so it scales with how many ranks shift and cannot
         be cleared from inside the job (taskpolicy -B -p $$ does not work).
         LowPriorityIO is the throttle worth keeping: measured cost 0.00s. -->
    <key>ProcessType</key>
    <string>Standard</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Umask</key>
    <integer>63</integer>
    <key>StandardOutPath</key>
    <string>/tmp/hanadocs-prioritize/launchd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/hanadocs-prioritize/launchd.stderr.log</string>
</dict>
</plist>
