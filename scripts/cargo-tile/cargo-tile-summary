#!/bin/zsh
# rev 44 — bump this comment in every cargo-tile source file on each change
# Live summary for the cargo-tile grid: revision, grid size, counts of
# tiled runs, plus cargo processes that predate `cargo-tile on`
# (uncapturable) — those lines disappear as the processes exit.
set -u

REVISION=44

TILE_HOME="${CARGO_TILE_HOME:-$HOME/.cargo-tile}"
STATE=/tmp/cargo-tile/state
ERRLOG=/tmp/cargo-tile/pane-errors.log

# self-refresh: re-exec when the source file's rev comment changes.
# $0 inside a zsh function is the function name, so capture it here.
SELF="$0"
src_rev() { sed -n '2s/^# rev \([0-9]*\).*/\1/p' "$SELF" 2>/dev/null; }

# OSC 0 sets the session name (what iTerm displays), not just the
# window title
printf '\033]0;cargo-tile summary\007'

while true; do
    rev="$(src_rev)"
    [[ -n "$rev" && "$rev" != "$REVISION" ]] && exec "$SELF"

    # a sandboxed caller can't drive iTerm — do its deferred grid
    # rebuild (growth, retreat, window recovery) on its behalf
    if [[ -f "$STATE/rebuild-needed" ]]; then
        rm -f "$STATE/rebuild-needed"
        "$TILE_HOME/bin/cargo-tile-pane" --check \
            >/dev/null 2>>"$ERRLOG" &!
    fi

    cols=$(tput cols 2>/dev/null) || cols=80

    # tiled runs still executing (pid files cleaned up by the shim);
    # collect "epoch TAB path TAB pid TAB command" lines, oldest first —
    # the pid file's mtime is the run's start time
    running=0
    now=$(date +%s)
    typeset -a active
    active=()
    for f in "$STATE"/pids/*(N); do
        if kill -0 "${f:t}" 2>/dev/null; then
            (( running += 1 ))
            if [[ -s "$f" ]]; then
                entry="$(<"$f")"
                ep=$(stat -f %m "$f" 2>/dev/null) || ep=$now
                active+=("$ep	${entry%%	*}	${f:t}	${entry#*	}")
            fi
        else
            rm -f "$f"
        fi
    done
    (( ${#active} > 0 )) && active=(${(on)active})

    # build-dir lock contention: runs sharing a path serialize behind
    # cargo's file lock, and a waiter announces it in its own output —
    # trust the log tail over any process-tree heuristic (a blocked
    # cargo still has helper children, so tree shape can't tell holder
    # from waiter). Match only the escape-code-free part of the line.
    typeset -A path_pids blocked_by
    path_pids=()
    blocked_by=()
    for entry in "${active[@]}"; do
        rest="${entry#*	}"
        rpath="${rest%%	*}"
        rest="${rest#*	}"
        path_pids[$rpath]+="${rest%%	*} "
    done
    for p in "${(k)path_pids[@]}"; do
        typeset -a group waiting free lgs
        group=(${=path_pids[$p]})
        (( ${#group} < 2 )) && continue
        waiting=()
        free=()
        for pid in "${group[@]}"; do
            lgs=(/tmp/cargo-tile/run-*-$pid.log(N))
            if (( ${#lgs} > 0 )) && \
                tail -4 "${lgs[1]}" 2>/dev/null | grep -q 'waiting for file lock'; then
                waiting+=("$pid")
            else
                free+=("$pid")
            fi
        done
        # a waiter is blocked no matter how many holders are plausible —
        # only the attribution needs a unique candidate. With several
        # non-waiting runs (e.g. one building, one testing) the holder
        # is unknowable from here, so mark the waiter and show "?"
        if (( ${#waiting} > 0 )); then
            holder="?"
            (( ${#free} == 1 )) && holder="${free[1]}"
            for pid in "${waiting[@]}"; do
                blocked_by[$pid]="$holder"
            done
        fi
    done

    # pane layout: total pane count and the column shape (e.g. 3+3+1)
    P=0
    shapestr=""
    if [[ -s "$STATE/layout" ]]; then
        typeset -a lw
        while IFS= read -r lline; do
            # split first: ${#${=x}} on a one-word line is its string
            # length, not 1
            lw=(${=lline})
            (( P += ${#lw} ))
            shapestr+="${shapestr:+ + }${#lw}"
        done < "$STATE/layout"
    fi
    shown=0
    for sf in "$STATE"/slots/*(N); do
        [[ -s "$sf" ]] || continue
        (( shown += 1 ))
        # reap slots whose run is gone — adopted runs have no shim to
        # call --remove. The log name embeds the root pid; 10s of quiet
        # keeps this from racing the shim's own exit-banner linger.
        l=$(<"$sf")
        lpid="${${l:t:r}##*-}"
        if [[ "$lpid" == <-> ]] && ! kill -0 "$lpid" 2>/dev/null; then
            if (( $(date +%s) - $(stat -f %m "$l" 2>/dev/null || echo 0) > 10 )); then
                "$TILE_HOME/bin/cargo-tile-pane" --remove "$l" \
                    >/dev/null 2>>"$ERRLOG" &!
            fi
        fi
    done

    # self-heal: more runs than panes with no pending marker means an
    # add was dropped or a split failed — request a converge
    want=$(( shown + 1 ))
    (( want > 36 )) && want=36
    if (( want > P )) && [[ ! -f "$STATE/rebuild-needed" ]]; then
        touch "$STATE/rebuild-needed"
    fi

    # decay: with more panes than tiles, close one trailing idle pane
    # every 15s (the pane script guards against closing a busy one)
    if (( P <= shown + 1 )) || [[ ! -f "$STATE/decay-last" ]]; then
        touch "$STATE/decay-last"
    elif (( $(date +%s) - $(stat -f %m "$STATE/decay-last") >= 15 )); then
        touch "$STATE/decay-last"
        "$TILE_HOME/bin/cargo-tile-pane" --decay \
            >/dev/null 2>>"$ERRLOG" &!
    fi

    # pre-existing cargo processes: snapshot taken at `cargo-tile on`,
    # pruned as they exit
    typeset -a pre
    pre=()
    if [[ -f "$STATE/preexisting" ]]; then
        while IFS=$'\t' read -r pid cmd; do
            [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && pre+=("$pid	$cmd")
        done < "$STATE/preexisting"
        print -rl -- "${pre[@]}" > "$STATE/preexisting" 2>/dev/null
    fi

    buf=""
    buf+=$'\033[1;36mcargo-tile\033[0m  \033[35mrev '"$REVISION"$'\033[0m  \033[2m'"$(date '+%H:%M:%S')"$'\033[0m\n\n'
    buf+=$'\033[1mpanes:\033[0m            '"${shapestr:-none} ($P)"$'\n'
    buf+=$'\033[1mrunning (tiled):\033[0m  '"$running"$'\n'
    buf+=$'\033[1mtiles in use:\033[0m     '"$(( shown + 1 )) / $P"$'\n'
    if (( ${#active} > 0 )); then
        pw=4   # "path"
        dw=3   # "pid"
        sw=5   # "start" / "hh:mm"
        cw=7   # "command"
        show_hours=0
        for entry in "${active[@]}"; do
            ep="${entry%%	*}"
            rest="${entry#*	}"
            rpath="${rest%%	*}"
            rest="${rest#*	}"
            rpid="${rest%%	*}"
            rcmd="${rest#*	}"
            (( ${#rpath} > pw )) && pw=${#rpath}
            (( ${#rpid} > dw )) && dw=${#rpid}
            (( ${#rcmd} > cw )) && cw=${#rcmd}
            (( now - ep > 3599 )) && show_hours=1
        done
        uw=5   # "mm:ss"; hh:mm:ss when any run passes the hour
        (( show_hours )) && uw=8
        # width-aware: the full table only when every column fits the
        # pane; otherwise a compact form — path on its own dim line
        # (repeated only when it changes), command truncated — so
        # nothing ever wraps in a small window
        bw=0
        if (( ${#blocked_by} > 0 )); then
            bw=7   # "blocker"
            for blk in "${(v)blocked_by[@]}"; do
                (( ${#blk} > bw )) && bw=${#blk}
            done
        fi
        need=$(( 2 + pw + 2 + dw + 2 + sw + 2 + uw + 2 + cw ))
        (( bw )) && (( need += 2 + bw ))
        wide=1
        (( need > cols )) && wide=0
        buf+=$'\n\033[1mactive:\033[0m\n'
        if (( ! wide )); then
            hdr="$(printf '  %-*s  %-*s  %-*s  command' "$dw" pid "$sw" start "$uw" dur)"
            buf+=$'\033[2m'"${hdr[1,$cols]}"$'\033[0m\n'
        elif (( ${#blocked_by} > 0 )); then
            buf+=$'\033[2m'"$(printf '  %-*s  %-*s  %-*s  %-*s  %-*s  blocker' "$pw" path "$dw" pid "$sw" start "$uw" dur "$cw" command)"$'\033[0m\n'
        else
            buf+=$'\033[2m'"$(printf '  %-*s  %-*s  %-*s  %-*s  %s' "$pw" path "$dw" pid "$sw" start "$uw" dur command)"$'\033[0m\n'
        fi
        prevpath=""
        for entry in "${active[@]}"; do
            ep="${entry%%	*}"
            rest="${entry#*	}"
            rpath="${rest%%	*}"
            rest="${rest#*	}"
            rpid="${rest%%	*}"
            rcmd="${rest#*	}"
            blk="${blocked_by[$rpid]:-}"
            secs=$(( now - ep ))
            (( secs < 0 )) && secs=0
            if (( show_hours )); then
                dur="$(printf '%02d:%02d:%02d' $(( secs / 3600 )) $(( secs % 3600 / 60 )) $(( secs % 60 )))"
            else
                dur="$(printf '%02d:%02d' $(( secs / 60 )) $(( secs % 60 )))"
            fi
            birth="$(date -r "$ep" '+%H:%M' 2>/dev/null)"
            fpath="$(printf '%-*s' "$pw" "$rpath")"
            fpid="$(printf '%-*s' "$dw" "$rpid")"
            fbirth="$(printf '%-*s' "$sw" "$birth")"
            fdur="$(printf '%-*s' "$uw" "$dur")"
            if (( ! wide )); then
                if [[ "$rpath" != "$prevpath" ]]; then
                    pline="  $rpath"
                    buf+=$'\033[2m'"${pline[1,$cols]}"$'\033[0m\n'
                    prevpath="$rpath"
                fi
                blkmark=""
                [[ -n "$blk" ]] && blkmark="⇠${blk}  "
                avail=$(( cols - 2 - dw - 2 - sw - 2 - uw - 2 - ${#blkmark} ))
                (( avail < 0 )) && avail=0
                (( ${#rcmd} > avail )) && rcmd="${rcmd[1,$avail]}"
                if [[ -n "$blk" ]]; then
                    buf+="  "$'\033[31m'"${fpid}"$'\033[0m'"  ${fbirth}  ${fdur}  "$'\033[33m'"${blkmark}"$'\033[0m'$'\033[36m'"${rcmd}"$'\033[0m\n'
                else
                    buf+="  ${fpid}  ${fbirth}  ${fdur}  "$'\033[36m'"${rcmd}"$'\033[0m\n'
                fi
            elif (( ${#blocked_by} > 0 )); then
                fcmd="$(printf '%-*s' "$cw" "$rcmd")"
                if [[ -n "$blk" ]]; then
                    # blocked run: its own pid in red
                    buf+="  ${fpath}  "$'\033[31m'"${fpid}"$'\033[0m'"  ${fbirth}  ${fdur}  "$'\033[36m'"${fcmd}"$'\033[0m'"  ${blk}"$'\n'
                else
                    buf+="  ${fpath}  ${fpid}  ${fbirth}  ${fdur}  "$'\033[36m'"${fcmd}"$'\033[0m\n'
                fi
            else
                buf+="  ${fpath}  ${fpid}  ${fbirth}  ${fdur}  "$'\033[36m'"${rcmd}"$'\033[0m\n'
            fi
        done
    fi
    if (( ${#pre} > 0 )); then
        touch "$STATE/pre-last"
        buf+=$'\n\033[1;33mpre-existing (not captured):\033[0m  '"${#pre}"$'\n'
        for entry in "${pre[@]}"; do
            pid="${entry%%	*}"
            cmd="${entry#*	}"
            # strip the leading binary path down to "cargo"
            cmd="cargo ${cmd#* }"
            line="  $pid  $cmd"
            buf+="${line[1,$cols]}"$'\n'
        done
    else
        # placeholder shows for a minute after `on` (or after the last
        # pre-existing process exits), then the section vanishes
        ref="$STATE/pre-last"
        [[ -f "$ref" ]] || ref="$TILE_HOME/active"
        if [[ -f "$ref" ]] && (( $(date +%s) - $(stat -f %m "$ref") < 60 )); then
            buf+=$'\n\033[2mno pre-existing cargo processes\033[0m\n'
        fi
    fi

    buf+=$'\n\033[2m[q] exit to shell\033[0m\n'

    printf '\033[H\033[2J\033[3J'
    print -rn -- "$buf"
    # q drops this pane to an interactive shell
    if [[ -t 0 ]]; then
        key=""
        read -s -t 2 -k 1 key 2>/dev/null
        if [[ "$key" == q ]]; then
            printf '\033[H\033[2J\033[3J'
            exec /bin/zsh -il
        fi
    else
        sleep 2
    fi
done
