#!/bin/zsh
# rev 66 — bump this comment in every cargo-tile source file on each change
# Live summary for the cargo-tile grid: revision, grid size, tiled runs,
# compiler activity (including rustc owned by the sccache server), plus Cargo
# processes that predate `cargo-tile on` — those lines disappear as they exit.
set -u

REVISION=66

TILE_HOME="${CARGO_TILE_HOME:-$HOME/.cargo-tile}"

# idle panes close this many seconds after their content leaves them —
# cargo-tile.conf is the one place it is set, so pane, slot and summary
# cannot drift apart; test mode overrides it to a second
source "${0:A:h}/conf.zsh"
STATE="$TILE_STATE"
ERRLOG="$TILE_ERRLOG"
DECAY_SECS=$(tile_decay_secs)

# self-refresh: re-exec when the source file's rev comment changes.
# $0 inside a zsh function is the function name, so capture it here.
SELF="$0"
src_rev() { sed -n '2s/^# rev \([0-9]*\).*/\1/p' "$SELF" 2>/dev/null; }

# OSC 0 sets the session name (what iTerm displays), not just the
# window title
printf '\033]0;cargo-tile summary\007'

# tag the session so the orphan sweep can tell this instance's grid
# window from one the user owns — or from another instance's grid;
# pressing q below clears the tag
printf '\033]1337;SetUserVar=cargotile=%s\007' "$(tile_tag_b64)"

last_decay_spawn=0
painted=""

# Test mode stands a synthetic run up in a slot so growth and decay can
# be driven by hand. The tile has to hold a real (if near-empty) log:
# cargo-tile-pane drops any slot whose file is gone, so a slot pointing
# at nothing would be swept before the grid ever grew. Line 1 carries the
# OSC 2 title the same way a run's log does, which is where the pane gets
# its name.
TESTDIR="$STATE/test"

test_add() {
    local n=0
    mkdir -p "$TESTDIR"
    [[ -s "$TESTDIR/seq" ]] && n=$(<"$TESTDIR/seq")
    (( n += 1 ))
    print -r -- "$n" > "$TESTDIR/seq"
    # no dash before the digits: the summary reaps a slot whose log name
    # ends in a dead pid, and "testtile7" never parses as one
    local l="$TESTDIR/testtile$n.log"
    {
        printf '\033]2;test tile %s\007\n' "$n"
        printf '\033[2m  synthetic tile %s — cargo-tile test mode\033[0m\n' "$n"
    } > "$l"
    "$TILE_HOME/bin/cargo-tile-pane" "$l" >/dev/null 2>>"$ERRLOG" &!
}

# Drop the last synthetic tile, which is also the last tile in the grid
# whenever any exists — test tiles are only ever appended. Real runs are
# left alone on purpose: --remove deletes the log it unregisters, and
# doing that to a live build would cut its output off mid-run.
test_drop() {
    local f l last=""
    for f in "$STATE"/slots/*(Nn); do
        [[ -s "$f" ]] || continue
        l=$(<"$f")
        [[ "$l" == "$TESTDIR/"* ]] && last="$l"
    done
    [[ -n "$last" ]] || return 1
    "$TILE_HOME/bin/cargo-tile-pane" --remove "$last" >/dev/null 2>>"$ERRLOG" &!
}

# Unregistering has to be serial — each call takes the layout lock — so it
# runs detached rather than freezing the summary for a second per tile.
# Disowned, it also outlives the exec on the way out through q.
test_clear() {
    local f l
    for f in "$STATE"/slots/*(Nn); do
        [[ -s "$f" ]] || continue
        l=$(<"$f")
        [[ "$l" == "$TESTDIR/"* ]] || continue
        "$TILE_HOME/bin/cargo-tile-pane" --remove "$l" >/dev/null 2>>"$ERRLOG"
    done
}

# Leaving test mode takes the synthetic tiles with it — the flag drops
# first so they decay at the real interval rather than vanishing in a
# second, which is the same retreat any finished run gets.
test_off() {
    rm -f "$TILE_TEST_FLAG"
    test_clear &!
}

# With more panes than tiles, wake the closer once the trailing pane's
# DECAY_SECS is up — dated from its own map file mtime (when its content
# left) or decay-last (when the close in front of it made it the trailing
# pane), whichever came later. That is the same rule the pane script
# counts down, so the number a pane shows is the one it gets. Called every
# frame rather than once per stats pass, so a one-second test-mode decay
# is not rounded up to the stats interval; cargo-tile-pane rechecks all of
# this under the lock, so an eager spawn is at worst a wasted process. The
# throttle is in memory and tracks DECAY_SECS, because a fixed five
# seconds would gate a one-second decay to a fifth of its rate:
# decay-last means "a pane closed", and stamping it here would hand the
# next pane back a free window.
maybe_decay() {
    local gap=5 now tmt dl
    (( DECAY_SECS < gap )) && gap=$DECAY_SECS
    (( gap < 1 )) && gap=1
    (( P > shown + 1 )) || return
    [[ -n "$tailord" ]] || return
    (( SECONDS - last_decay_spawn >= gap )) || return
    now=$(date +%s)
    tmt=$(stat -f %m "$STATE/panemap/$tailord" 2>/dev/null) || tmt=$now
    dl=$(stat -f %m "$STATE/decay-last" 2>/dev/null) || dl=0
    (( tmt > dl )) && dl=$tmt
    (( now - dl >= DECAY_SECS )) || return
    last_decay_spawn=$SECONDS
    "$TILE_HOME/bin/cargo-tile-pane" --decay >/dev/null 2>>"$ERRLOG" &!
}

# Move the grid one pane closer to the layout cargo-tile-pane published,
# and stop. Walking target-order — the reading order — is what turns a
# reflow into motion: the cell a split just opened is the first mismatch,
# so it fills first, then each pane behind it hands its content back one
# position, and the wave ends with the new run in the last pane. One pane
# per frame means nothing ever jumps, and a run leaving animates the same
# way as one arriving. Returns 1 when the grid already matches.
step_reflow() {
    [[ -s "$STATE/target-order" ]] || return 1
    local o want cur
    while IFS= read -r o; do
        [[ -n "$o" ]] || continue
        want=""
        [[ -s "$STATE/target/$o" ]] && want=$(<"$STATE/target/$o")
        cur=""
        [[ -s "$STATE/panemap/$o" ]] && cur=$(<"$STATE/panemap/$o")
        # a missing map file counts as a mismatch even when the content
        # already agrees (both empty). The file's mtime is what decay
        # dates the trailing pane from, and a pane that never had one
        # reads as "idle since now" on every pass — so it never ages out,
        # and nothing behind it can become the trailing pane either.
        # Before the reflow moved map writing here, sync_maps wrote one
        # for every pane, so this was never reachable.
        if [[ "$want" != "$cur" || ! -f "$STATE/panemap/$o" ]]; then
            print -r -- "$want" > "$STATE/panemap/$o"
            return 0
        fi
    done < "$STATE/target-order"
    return 1
}

while true; do
    # re-read so a conf edit lands on the running grid without a restart
    DECAY_SECS=$(tile_decay_secs)
    IDLE_BG=$(tile_conf_str idle_bg "$TILE_IDLE_BG_DEFAULT")
    rev="$(src_rev)"
    [[ -n "$rev" && "$rev" != "$REVISION" ]] && exec "$SELF"

    # a sandboxed caller can't drive iTerm — do its deferred grid
    # rebuild (growth, retreat, window recovery) on its behalf
    if [[ -f "$STATE/rebuild-needed" ]]; then
        rm -f "$STATE/rebuild-needed"
        "$TILE_HOME/bin/cargo-tile-pane" --check \
            >/dev/null 2>>"$ERRLOG" &!
    fi

    cols=$(tput cols 2>/dev/null) || cols=80

    # tiled runs still executing (pid files cleaned up by the shim);
    # collect "epoch TAB path TAB pid TAB command" lines, oldest first —
    # the pid file's mtime is the run's start time
    running=0
    now=$(date +%s)
    typeset -a active
    typeset -A tile_roots
    active=()
    tile_roots=()
    for f in "$STATE"/pids/*(N); do
        if kill -0 "${f:t}" 2>/dev/null; then
            (( running += 1 ))
            tile_roots[${f:t}]=1
            if [[ -s "$f" ]]; then
                entry="$(<"$f")"
                ep=$(stat -f %m "$f" 2>/dev/null) || ep=$now
                active+=("$ep	${entry%%	*}	${f:t}	${entry#*	}")
            fi
        else
            rm -f "$f"
        fi
    done
    (( ${#active} > 0 )) && active=(${(on)active})

    # build-dir lock contention: runs sharing a path serialize behind
    # cargo's file lock, and a waiter announces it in its own output —
    # trust the log tail over any process-tree heuristic (a blocked
    # cargo still has helper children, so tree shape can't tell holder
    # from waiter). Match only the escape-code-free part of the line.
    typeset -A path_pids blocked_by
    path_pids=()
    blocked_by=()
    for entry in "${active[@]}"; do
        rest="${entry#*	}"
        rpath="${rest%%	*}"
        rest="${rest#*	}"
        path_pids[$rpath]+="${rest%%	*} "
    done
    for p in "${(k)path_pids[@]}"; do
        typeset -a group waiting free lgs
        group=(${=path_pids[$p]})
        (( ${#group} < 2 )) && continue
        waiting=()
        free=()
        for pid in "${group[@]}"; do
            lgs=("$TILE_ROOT"/run-*-$pid.log(N))
            if (( ${#lgs} > 0 )) && \
                tail -4 "${lgs[1]}" 2>/dev/null | grep -q 'waiting for file lock'; then
                waiting+=("$pid")
            else
                free+=("$pid")
            fi
        done
        # a waiter is blocked no matter how many holders are plausible —
        # only the attribution needs a unique candidate. With several
        # non-waiting runs (e.g. one building, one testing) the holder
        # is unknowable from here, so mark the waiter and show "?"
        if (( ${#waiting} > 0 )); then
            holder="?"
            (( ${#free} == 1 )) && holder="${free[1]}"
            for pid in "${waiting[@]}"; do
                blocked_by[$pid]="$holder"
            done
        fi
    done

    # pane layout: total pane count and the column shape (e.g. 3+3+1)
    P=0
    shapestr=""
    tailord=""
    if [[ -s "$STATE/layout" ]]; then
        typeset -a lw
        while IFS= read -r lline; do
            # split first: ${#${=x}} on a one-word line is its string
            # length, not 1
            lw=(${=lline})
            (( ${#lw} > 0 )) || continue
            (( P += ${#lw} ))
            shapestr+="${shapestr:+ + }${#lw}"
            # last pane in flatten order — the only one decay can close
            tailord="${lw[-1]%%:*}"
        done < "$STATE/layout"
    fi
    shown=0
    for sf in "$STATE"/slots/*(N); do
        [[ -s "$sf" ]] || continue
        (( shown += 1 ))
        # reap slots whose run is gone — adopted runs have no shim to
        # call --remove. The log name embeds the root pid; 10s of quiet
        # keeps this from racing the shim's own exit-banner linger.
        l=$(<"$sf")
        lpid="${${l:t:r}##*-}"
        if [[ "$lpid" == <-> ]] && ! kill -0 "$lpid" 2>/dev/null; then
            if (( $(date +%s) - $(stat -f %m "$l" 2>/dev/null || echo 0) > 10 )); then
                "$TILE_HOME/bin/cargo-tile-pane" --remove "$l" \
                    >/dev/null 2>>"$ERRLOG" &!
            fi
        fi
    done

    # self-heal: more runs than panes with no pending marker means an
    # add was dropped or a split failed — request a converge
    want=$(( shown + 1 ))
    (( want > 36 )) && want=36
    if (( want > P )) && [[ ! -f "$STATE/rebuild-needed" ]]; then
        touch "$STATE/rebuild-needed"
    fi

    maybe_decay

    # pre-existing cargo processes: snapshot taken at `cargo-tile on`,
    # pruned as they exit
    typeset -a pre
    pre=()
    if [[ -f "$STATE/preexisting" ]]; then
        while IFS=$'\t' read -r pid cmd; do
            [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && pre+=("$pid	$cmd")
        done < "$STATE/preexisting"
        print -rl -- "${pre[@]}" > "$STATE/preexisting" 2>/dev/null
    fi

    # this pane is idle when cargo-tile is watching nothing: no tiled run
    # alive and no pre-existing cargo process left over from `on`. Same
    # tint the slot panes use for an empty pane, so one color means the
    # same thing everywhere in the window — nothing is happening here —
    # and a fully quiet grid goes green all over.
    if (( running == 0 && ${#pre} == 0 )); then
        state=idle
    else
        state=normal
    fi
    # an idle pane is keyed on its tint as well as its state, so retuning
    # idle_bg lands on it instead of waiting for the next run to come and
    # go; a busy pane is keyed on the state alone, since painting it
    # normal means a terminal reset and there is nothing to reset twice.
    # The frame below redraws whatever that reset clears.
    want="$state"
    [[ "$state" == idle ]] && want="idle:$IDLE_BG"
    if [[ "$want" != "$painted" ]]; then
        painted="$want"
        tile_paint "$state" "$IDLE_BG"
    fi

    # Compiler ownership is not the same as build ownership when sccache is
    # active. Cargo's short-lived sccache client remains in the tiled run's
    # process tree, but the CPU-heavy rustc is spawned by the persistent
    # server (usually parented by launchd). Join through the client so the
    # work is shown on the right Cargo session, and report anything with no
    # tiled ancestor instead of letting server-owned work disappear.
    typeset -A proc_parent proc_command direct_by_root sccache_by_root
    proc_parent=()
    proc_command=()
    direct_by_root=()
    sccache_by_root=()
    compiler_workers=0
    sccache_workers=0
    linked_sccache_requests=0
    untiled_sccache_requests=0
    untiled_direct_workers=0
    while read -r scan_pid scan_ppid scan_cmd; do
        [[ "$scan_pid" == <-> && "$scan_ppid" == <-> ]] || continue
        proc_parent[$scan_pid]="$scan_ppid"
        proc_command[$scan_pid]="$scan_cmd"
    done < <(ps -axo pid=,ppid=,command= 2>/dev/null)

    tile_root_for() {
        local current="$1" parent depth=0
        while [[ "$current" == <-> ]] && (( current > 1 && depth < 64 )); do
            if [[ -n "${tile_roots[$current]:-}" ]]; then
                print -r -- "$current"
                return 0
            fi
            parent="${proc_parent[$current]:-}"
            [[ -n "$parent" && "$parent" != "$current" ]] || break
            current="$parent"
            (( depth += 1 ))
        done
        return 1
    }

    for scan_pid in "${(k)proc_command[@]}"; do
        scan_cmd="${proc_command[$scan_pid]}"
        scan_exe="${scan_cmd%% *}"
        scan_base="${scan_exe:t}"
        case "$scan_base" in
            rustc|rustdoc|clippy-driver)
                (( compiler_workers += 1 ))
                scan_ppid="${proc_parent[$scan_pid]:-}"
                parent_cmd="${proc_command[$scan_ppid]:-}"
                parent_exe="${parent_cmd%% *}"
                if [[ "${parent_exe:t}" == sccache ]]; then
                    (( sccache_workers += 1 ))
                elif root=$(tile_root_for "$scan_pid"); then
                    direct_by_root[$root]=$(( ${direct_by_root[$root]:-0} + 1 ))
                else
                    (( untiled_direct_workers += 1 ))
                fi
                ;;
            sccache)
                # The server has no compiler argument. A request client starts
                # with the rustc/rustdoc/clippy-driver path it is wrapping.
                scan_rest="${scan_cmd#* }"
                [[ "$scan_rest" != "$scan_cmd" ]] || continue
                compiler_exe="${scan_rest%% *}"
                case "${compiler_exe:t}" in
                    rustc|rustdoc|clippy-driver) ;;
                    *) continue ;;
                esac
                if root=$(tile_root_for "$scan_pid"); then
                    sccache_by_root[$root]=$(( ${sccache_by_root[$root]:-0} + 1 ))
                    (( linked_sccache_requests += 1 ))
                else
                    (( untiled_sccache_requests += 1 ))
                fi
                ;;
        esac
    done

    buf=""
    buf+=$'\033[1;36mcargo-tile\033[0m  \033[35mrev '"$REVISION"$'\033[0m  \033[2m'"$(date '+%H:%M:%S')"$'\033[0m\n\n'
    buf+=$'\033[1mpanes:\033[0m            '"${shapestr:-none} ($P)"$'\n'
    buf+=$'\033[1mrunning (tiled):\033[0m  '"$running"$'\n'
    buf+=$'\033[1mtiles in use:\033[0m     '"$(( shown + 1 )) / $P"$'\n'
    if (( compiler_workers > 0 || linked_sccache_requests > 0 || untiled_sccache_requests > 0 )); then
        buf+=$'\033[1mcompiler workers:\033[0m '"$compiler_workers"
        (( sccache_workers > 0 )) && buf+=" ($sccache_workers sccache-owned)"
        buf+=$'\n'
        if (( linked_sccache_requests > 0 )); then
            buf+=$'\033[1msccache requests:\033[0m '"$linked_sccache_requests linked to tiles"$'\n'
        fi
        if (( untiled_sccache_requests > 0 || untiled_direct_workers > 0 )); then
            untiled_total=$(( untiled_sccache_requests + untiled_direct_workers ))
            buf+=$'\033[1;31muntiled compiler activity:\033[0m '"$untiled_total"
            (( untiled_sccache_requests > 0 )) && buf+=" ($untiled_sccache_requests via sccache)"
            buf+=$'\n'
        fi
    fi
    if (( ${#active} > 0 )); then
        pw=4   # "path"
        dw=3   # "pid"
        sw=5   # "start" / "hh:mm"
        aw=8   # "compiler"
        cw=7   # "command"
        show_hours=0
        for entry in "${active[@]}"; do
            ep="${entry%%	*}"
            rest="${entry#*	}"
            rpath="${rest%%	*}"
            rest="${rest#*	}"
            rpid="${rest%%	*}"
            rcmd="${rest#*	}"
            direct="${direct_by_root[$rpid]:-0}"
            cached="${sccache_by_root[$rpid]:-0}"
            rwork=""
            (( direct > 0 )) && rwork="rustc×$direct"
            (( cached > 0 )) && rwork+="${rwork:+ + }sccache×$cached"
            [[ -n "$rwork" ]] || rwork="—"
            (( ${#rpath} > pw )) && pw=${#rpath}
            (( ${#rpid} > dw )) && dw=${#rpid}
            (( ${#rwork} > aw )) && aw=${#rwork}
            (( ${#rcmd} > cw )) && cw=${#rcmd}
            (( now - ep > 3599 )) && show_hours=1
        done
        uw=5   # "mm:ss"; hh:mm:ss when any run passes the hour
        (( show_hours )) && uw=8
        # width-aware: the full table only when every column fits the
        # pane; otherwise a compact form — path on its own dim line
        # (repeated only when it changes), command truncated — so
        # nothing ever wraps in a small window
        bw=0
        if (( ${#blocked_by} > 0 )); then
            bw=7   # "blocker"
            for blk in "${(v)blocked_by[@]}"; do
                (( ${#blk} > bw )) && bw=${#blk}
            done
        fi
        need=$(( 2 + pw + 2 + dw + 2 + sw + 2 + uw + 2 + aw + 2 + cw ))
        (( bw )) && (( need += 2 + bw ))
        wide=1
        (( need > cols )) && wide=0
        buf+=$'\n\033[1mactive:\033[0m\n'
        if (( ! wide )); then
            hdr="$(printf '  %-*s  %-*s  %-*s  compiler  command' "$dw" pid "$sw" start "$uw" dur)"
            buf+=$'\033[37m'"${hdr[1,$cols]}"$'\033[0m\n'
        elif (( ${#blocked_by} > 0 )); then
            buf+=$'\033[37m'"$(printf '  %-*s  %-*s  %-*s  %-*s  %-*s  %-*s  blocker' "$pw" path "$dw" pid "$sw" start "$uw" dur "$aw" compiler "$cw" command)"$'\033[0m\n'
        else
            buf+=$'\033[37m'"$(printf '  %-*s  %-*s  %-*s  %-*s  %-*s  %s' "$pw" path "$dw" pid "$sw" start "$uw" dur "$aw" compiler command)"$'\033[0m\n'
        fi
        prevpath=""
        for entry in "${active[@]}"; do
            ep="${entry%%	*}"
            rest="${entry#*	}"
            rpath="${rest%%	*}"
            rest="${rest#*	}"
            rpid="${rest%%	*}"
            rcmd="${rest#*	}"
            blk="${blocked_by[$rpid]:-}"
            direct="${direct_by_root[$rpid]:-0}"
            cached="${sccache_by_root[$rpid]:-0}"
            rwork=""
            (( direct > 0 )) && rwork="rustc×$direct"
            (( cached > 0 )) && rwork+="${rwork:+ + }sccache×$cached"
            [[ -n "$rwork" ]] || rwork="—"
            secs=$(( now - ep ))
            (( secs < 0 )) && secs=0
            if (( show_hours )); then
                dur="$(printf '%02d:%02d:%02d' $(( secs / 3600 )) $(( secs % 3600 / 60 )) $(( secs % 60 )))"
            else
                dur="$(printf '%02d:%02d' $(( secs / 60 )) $(( secs % 60 )))"
            fi
            birth="$(date -r "$ep" '+%H:%M' 2>/dev/null)"
            fpath="$(printf '%-*s' "$pw" "$rpath")"
            fpid="$(printf '%-*s' "$dw" "$rpid")"
            fbirth="$(printf '%-*s' "$sw" "$birth")"
            fdur="$(printf '%-*s' "$uw" "$dur")"
            fwork="$(printf '%-*s' "$aw" "$rwork")"
            if (( ! wide )); then
                if [[ "$rpath" != "$prevpath" ]]; then
                    pline="  $rpath"
                    buf+=$'\033[1;33m'"${pline[1,$cols]}"$'\033[0m\n'
                    prevpath="$rpath"
                fi
                blkmark=""
                [[ -n "$blk" ]] && blkmark="⇠${blk}  "
                avail=$(( cols - 2 - dw - 2 - sw - 2 - uw - 2 - ${#rwork} - 2 - ${#blkmark} ))
                (( avail < 0 )) && avail=0
                (( ${#rcmd} > avail )) && rcmd="${rcmd[1,$avail]}"
                if [[ -n "$blk" ]]; then
                    buf+="  "$'\033[31m'"${fpid}"$'\033[0m'"  ${fbirth}  ${fdur}  "$'\033[35m'"${rwork}"$'\033[0m'"  "$'\033[33m'"${blkmark}"$'\033[0m'$'\033[36m'"${rcmd}"$'\033[0m\n'
                else
                    buf+="  ${fpid}  ${fbirth}  ${fdur}  "$'\033[35m'"${rwork}"$'\033[0m'"  "$'\033[36m'"${rcmd}"$'\033[0m\n'
                fi
            elif (( ${#blocked_by} > 0 )); then
                fcmd="$(printf '%-*s' "$cw" "$rcmd")"
                if [[ -n "$blk" ]]; then
                    # blocked run: its own pid in red
                    buf+="  ${fpath}  "$'\033[31m'"${fpid}"$'\033[0m'"  ${fbirth}  ${fdur}  "$'\033[35m'"${fwork}"$'\033[0m'"  "$'\033[36m'"${fcmd}"$'\033[0m'"  ${blk}"$'\n'
                else
                    buf+="  ${fpath}  ${fpid}  ${fbirth}  ${fdur}  "$'\033[35m'"${fwork}"$'\033[0m'"  "$'\033[36m'"${fcmd}"$'\033[0m\n'
                fi
            else
                buf+="  ${fpath}  ${fpid}  ${fbirth}  ${fdur}  "$'\033[35m'"${fwork}"$'\033[0m'"  "$'\033[36m'"${rcmd}"$'\033[0m\n'
            fi
        done
    fi
    if (( ${#pre} > 0 )); then
        touch "$STATE/pre-last"
        buf+=$'\n\033[1;33mpre-existing (not captured):\033[0m  '"${#pre}"$'\n'
        for entry in "${pre[@]}"; do
            pid="${entry%%	*}"
            cmd="${entry#*	}"
            # strip the leading binary path down to "cargo"
            cmd="cargo ${cmd#* }"
            line="  $pid  $cmd"
            buf+="${line[1,$cols]}"$'\n'
        done
    else
        # placeholder shows for a minute after `on` (or after the last
        # pre-existing process exits), then the section vanishes
        ref="$STATE/pre-last"
        [[ -f "$ref" ]] || ref="$TILE_HOME/active"
        if [[ -f "$ref" ]] && (( $(date +%s) - $(stat -f %m "$ref") < 60 )); then
            buf+=$'\n\033[2mno pre-existing cargo processes\033[0m\n'
        fi
    fi

    if tile_test_mode; then
        buf+=$'\n\033[1;35mTEST MODE\033[0m\033[2m  [+] add tile   [-] drop the last one'
        buf+=" (decays in ${DECAY_SECS}s)"$'   [t] leave\033[0m\n'
    else
        buf+=$'\n\033[2m[t] test mode\033[0m\n'
    fi
    buf+=$'\033[2m[q] exit to shell\033[0m\n'

    printf '\033[H\033[2J\033[3J'
    print -rn -- "$buf"

    # Hold for the stats interval, but in frame-sized ticks: each one
    # advances the reflow by a single pane. The stats are cheap to read
    # at 2s and would look frantic faster; the reflow needs to be far
    # quicker than that or a layout change reads as a jump. A worst-case
    # step (29 -> 30 panes) is 25 frames, so the frame interval also sets
    # how long the longest slide takes.
    frame_ms=$(tile_conf reflow_ms 120)
    (( frame_ms < 20 )) && frame_ms=20
    tick=$(printf '%.3f' $(( frame_ms / 1000.0 )))
    waited=0
    while (( waited < 2000 )); do
        step_reflow
        maybe_decay
        # q drops this pane to an interactive shell
        if [[ -t 0 ]]; then
            key=""
            read -s -t "$tick" -k 1 key 2>/dev/null
            case "$key" in
                q)
                    tile_test_mode && test_off
                    tile_paint normal
                    printf '\033]1337;SetUserVar=cargotile=\007'
                    printf '\033[H\033[2J\033[3J'
                    exec /bin/zsh -il
                    ;;
                t)
                    if tile_test_mode; then test_off; else touch "$TILE_TEST_FLAG"; fi
                    break
                    ;;
                # = is + without the shift; both read as "one more"
                +|=)
                    tile_test_mode && { test_add; break }
                    ;;
                -|_)
                    tile_test_mode && { test_drop; break }
                    ;;
            esac
        else
            sleep "$tick"
        fi
        (( waited += frame_ms ))
    done
done
