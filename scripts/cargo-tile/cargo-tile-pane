#!/bin/zsh
# rev 69 — bump this comment in every cargo-tile source file on each change
# Assign runs to the cargo-tile pane layout.
#   cargo-tile-pane <log>           add a run
#   cargo-tile-pane --remove <log>  drop a finished run
#   cargo-tile-pane --check         converge layout (deferred work, recovery)
#   cargo-tile-pane --decay         close the trailing idle pane
#   cargo-tile-pane --close         close this instance's grid window
#
# Tile 1 is the summary; runs fill tiles 2..N in reading order (down
# column 1, then column 2, ...) so the grid is always in timestamp
# order top to bottom, left to right. Column heights come from
# shape_for below. Panes are added one split at a time as tiles
# arrive; a new COLUMN can't be made from a session split, so only
# column growth (N = 5, 9, 13, 21, 31) rebuilds the window. When runs
# leave, content shifts up (slots stay packed), trailing panes go idle
# in place, and --decay closes the trailing one DECAY_SECS after it
# cleared or after the close in front of it, whichever came later — so
# a refilled pane starts over and idle panes drop off one at a time.
#
# state/slots/<pos>   packed run logs, positions 2.. in reading order
# state/layout        one line per column: "ord:sessionid ..." top-down
# state/panemap/<o>   the log pane <o> shows (empty = idle); watched by
#                     cargo-tile-slot <o>
# state/target/<o>    the log pane <o> should end up showing
# state/target-order  pane ordinals in reading order; the summary walks
#                     it one pane per frame to animate the reflow
# state/test-mode     present while the grid is in test mode: + and - in
#                     the summary pane add and drop synthetic tiles, and
#                     decay runs at a second so a retreat can be watched
# state/test/         those tiles' logs, one per tile, plus their counter
set -u

TILE_HOME="${CARGO_TILE_HOME:-$HOME/.cargo-tile}"

# idle panes close this many seconds after their content leaves them —
# cargo-tile.conf is the one place it is set, so pane, slot and summary
# cannot drift apart; test mode overrides it to a second
source "${0:A:h}/conf.zsh"
STATE="$TILE_STATE"
ERRLOG="$TILE_ERRLOG"

# a pane iTerm2 launches starts from a fresh environment, so a non-default
# root has to travel in the command itself or the new pane would come up
# attached to the default instance
TILE_ENV=""
[[ "$TILE_ROOT" == /tmp/cargo-tile ]] || \
    TILE_ENV="/usr/bin/env CARGO_TILE_ROOT=$TILE_ROOT "
DECAY_SECS=$(tile_decay_secs)

mode=add
case "${1:-}" in
    --remove) mode=remove; shift ;;
    --check) mode=check; shift ;;
    --decay) mode=decay; shift ;;
    --close) mode=close; shift ;;
esac
LOG="${1:-}"
mkdir -p "$STATE/slots" "$STATE/panemap"

# Sandboxed callers (a cargo run from a Claude Code shell) never take the
# layout lock. Taking it works, but the sandbox can kill the holder before
# its EXIT trap releases it, and the steal path below is closed to them --
# it needs /bin/ps, which the sandbox blocks -- so one sandboxed corpse
# used to wedge the grid for every later caller until someone cleared the
# lock by hand. Hand the work to the summary pane instead: it polls
# rebuild-needed and spawns an unsandboxed --check, which re-registers
# live runs and reaps slots whose log is gone.
#
# Two carve-outs:
#   --close is an explicit teardown with nothing to defer to, so it locks
#     as before.
#   The handoff needs a summary pane to receive it, so it only applies once
#     a grid window exists. Before that -- a sandboxed `cargo-tile on` --
#     fall through and bootstrap the window directly, or nothing ever would.
if [[ "$mode" != close && -s "$STATE/window" ]] && ! /bin/ps -p $$ >/dev/null 2>&1; then
    touch "$STATE/rebuild-needed"
    exit 0
fi

# serialize concurrent invocations — running two of these at once
# interleaves osascript calls and corrupts the layout, so on timeout we
# DROP the event (a later --check self-heals) rather than run unlocked
LOCK="$STATE/lock"
locked=0
for i in {1..150}; do
    if mkdir "$LOCK" 2>/dev/null; then
        locked=1
        print -r -- $$ > "$LOCK/pid"
        break
    fi
    # a holder that crashed without its EXIT trap leaves the lock
    # behind — steal only when the recorded holder is dead (a slow
    # full_rebuild legitimately holds it well past any age threshold).
    # Sandboxed callers never steal: the sandbox blocks probing
    # unrelated pids, so kill -0 reports a live holder as dead.
    if (( i % 20 == 0 )) && /bin/ps -p $$ >/dev/null 2>&1; then
        hpid=""
        [[ -f "$LOCK/pid" ]] && hpid=$(<"$LOCK/pid")
        if [[ "$hpid" == <-> ]]; then
            # `kill -0` succeeds for a zombie, so a holder killed before
            # its EXIT trap ran keeps the lock forever and every later add
            # times out — the grid then never rebuilds and no window
            # appears. Process state is not a reliable tell either (an
            # exiting zsh reports `?NE`, not `Z`). Match the command line
            # instead: a live holder still shows its cargo-tile-pane
            # argv, while a corpse shows a bare parenthesized `(zsh)` and
            # a recycled pid shows something unrelated. All three of those
            # mean the lock is free.
            hcmd=$(/bin/ps -p "$hpid" -o command= 2>/dev/null)
            if [[ "$hcmd" != *cargo-tile-pane* ]]; then
                rm -rf "$LOCK" 2>/dev/null
            fi
        else
            # no pid recorded (holder died mid-acquire): fall back to age
            lage=$(( $(date +%s) - $(stat -f %m "$LOCK" 2>/dev/null || date +%s) ))
            (( lage > 60 )) && rm -rf "$LOCK" 2>/dev/null
        fi
    fi
    sleep 0.1
done
if (( ! locked )); then
    touch "$STATE/rebuild-needed"
    exit 0
fi
# rm -rf, not rmdir: the pid file inside makes rmdir fail silently, which
# leaks the lock on every release — sandboxed callers can't steal, so their
# adds then time out forever
trap 'rm -rf "$LOCK" 2>/dev/null' EXIT

# collect active slots (slot -> log), dropping stale entries
typeset -A slotlog
for f in "$STATE"/slots/*(N); do
    [[ -s "$f" ]] || continue
    l=$(<"$f")
    if [[ -f "$l" ]]; then
        slotlog[${f:t}]="$l"
    else
        : > "$f"
    fi
done

if [[ "$mode" == remove ]]; then
    for s in "${(k)slotlog[@]}"; do
        if [[ "${slotlog[$s]}" == "$LOG" ]]; then
            : > "$STATE/slots/$s"
            unset "slotlog[$s]"
        fi
    done
    ( sleep 0.7; rm -f "$LOG" ) &!
fi

# keep runs packed toward the front: close any holes left by removes
# (or stale entries) by shifting later runs up, preserving order
typeset -a packed
packed=()
for s in ${(kon)slotlog}; do packed+=("${slotlog[$s]}"); done
slotlog=()
i=2
for l in "${packed[@]}"; do
    cur=""
    [[ -s "$STATE/slots/$i" ]] && cur=$(<"$STATE/slots/$i")
    [[ "$cur" == "$l" ]] || print -r -- "$l" > "$STATE/slots/$i"
    slotlog[$i]="$l"
    (( i += 1 ))
done
for f in "$STATE"/slots/*(N); do
    (( ${f:t} >= i )) && [[ -s "$f" ]] && : > "$f"
done

if [[ "$mode" == add && -n "$LOG" ]]; then
    # a shim add can race --check adoption of the same run — never
    # register a log twice (two panes would tail the same output)
    dup=0
    for s in "${(k)slotlog[@]}"; do
        [[ "${slotlog[$s]}" == "$LOG" ]] && { dup=1; break }
    done
    slot=$(( ${#slotlog} + 2 ))
    if (( ! dup && slot <= 36 )); then
        print -r -- "$LOG" > "$STATE/slots/$slot"
        slotlog[$slot]="$LOG"
    fi
fi

N=$(( ${#slotlog} + 1 ))  # + summary tile
(( N > 36 )) && N=36

# current pane layout
typeset -a cols colw
[[ -s "$STATE/layout" ]] && cols=("${(@f)$(<"$STATE/layout")}")
P=0
for c in "${cols[@]}"; do
    # split first: ${#${=c}} on a one-word line is its string length, not 1
    colw=(${=c})
    (( P += ${#colw} ))
done

# Column heights for $1 tiles -> SHAPE. Growth alternates between
# deepening every column by one row (rightmost first) and appending a
# column on the right that fills top-down, so the caps run
# 4x4=16, 4x5=20, 5x5=25, 5x6=30, 6x6=36 — landing exactly on the tile
# ceiling. Right-to-left is not cosmetic: growing the leftmost column
# first would shift every column's contents, while growing the rightmost
# shifts only what is to its right, and the very first step of a row add
# shifts nothing at all.
shape_for() {
    local n=$1 R=4 C=4 base extra i
    typeset -ga SHAPE
    SHAPE=()
    if (( n <= 16 )); then
        # phase 1: columns of four, left to right, last one short
        while (( n > 0 )); do
            if (( n >= 4 )); then SHAPE+=(4); (( n -= 4 ))
            else SHAPE+=($n); n=0
            fi
        done
        return
    fi
    while true; do
        base=$(( R * C ))
        if (( n <= base + C )); then          # row add, rightmost first
            extra=$(( n - base ))
            for (( i = 1; i <= C - extra; i++ )); do SHAPE+=($R); done
            for (( i = 1; i <= extra; i++ )); do SHAPE+=($(( R + 1 ))); done
            return
        fi
        (( R += 1 ))
        base=$(( R * C ))
        if (( n <= base + R )); then          # column add on the right
            for (( i = 1; i <= C; i++ )); do SHAPE+=($R); done
            SHAPE+=($(( n - base )))
            return
        fi
        (( C += 1 ))
    done
}

# pane ordinals in snake order from $cols -> ORDS
flatten_ords() {
    typeset -ga ORDS
    ORDS=()
    local c e
    for c in "${cols[@]}"; do
        for e in ${=c}; do ORDS+=("${e%%:*}"); done
    done
}

# point every pane's map at the run for its position (pure file writes,
# safe from any caller); panes past the run list go idle
# Publish where every run BELONGS, not where it is shown. The summary
# walks target-order and moves one pane per frame, so a layout change
# slides through the grid instead of every pane swapping at once. The
# order is the reading order, which makes the shift travel forward: the
# cell a split just opened fills first, and each pane behind it hands its
# content back one position until the new run drops into the last pane.
sync_maps() {
    flatten_ords
    local i
    mkdir -p "$STATE/target"
    for (( i = 2; i <= ${#ORDS}; i++ )); do
        print -r -- "${slotlog[$i]:-}" > "$STATE/target/${ORDS[$i]}"
    done
    # (@) keeps the slice as separate words — quoted without it, zsh
    # joins them and the stepper reads the whole grid as one ordinal
    (( ${#ORDS} >= 2 )) && print -rl -- "${(@)ORDS[2,-1]}" > "$STATE/target-order"
    # a pane that left the layout keeps no claim on a run
    for i in "$STATE"/target/*(N); do
        [[ " ${ORDS[*]} " == *" ${i:t} "* ]] || rm -f "$i"
    done
}

# sandboxed caller (cargo from a Claude Code shell — detectable because
# the sandbox blocks exec of /bin/ps): slot and map files are plain
# /tmp writes, but osascript can't reach iTerm2, so pane creation and
# recovery are deferred to the summary pane via the rebuild-needed
# marker
if ! /bin/ps -p $$ >/dev/null 2>&1; then
    sync_maps
    if [[ ! -f "$STATE/window" ]] || (( N > P )); then
        touch "$STATE/rebuild-needed"
    fi
    exit 0
fi

# a --check is the self-heal entry point: re-register any live run
# whose add was dropped (lock contention) or whose slot was lost
if [[ "$mode" == check ]]; then
    typeset -A haslog
    for s in "${(k)slotlog[@]}"; do haslog[${slotlog[$s]}]=1; done
    for lg in "$TILE_ROOT"/run-*-*.log(N); do
        [[ -n "${haslog[$lg]:-}" ]] && continue
        pid="${${lg:t:r}##*-}"
        [[ "$pid" == <-> ]] || continue
        kill -0 "$pid" 2>/dev/null || continue
        # a finished run keeps its exit banner; a reused pid must not
        # resurrect it (same guard as adopt_live_runs)
        tail -2 "$lg" 2>/dev/null | grep -q -- '── exit ' && continue
        slot=$(( ${#slotlog} + 2 ))
        (( slot <= 36 )) || break
        print -r -- "$lg" > "$STATE/slots/$slot"
        slotlog[$slot]="$lg"
        haslog[$lg]=1
    done
    N=$(( ${#slotlog} + 1 ))
    (( N > 36 )) && N=36
fi

next_ord() {
    local o=1
    [[ -s "$STATE/pane-seq" ]] && o=$(<"$STATE/pane-seq")
    (( o += 1 ))
    print -r -- "$o" > "$STATE/pane-seq"
    print -r -- "$o"
}

even_arrange() {
    osascript <<'EOF' 2>/dev/null
try
	with timeout of 3 seconds
		tell application "System Events" to tell process "iTerm2"
			click menu item "Arrange Split Panes Evenly" of menu "View" of menu bar 1
		end tell
	end timeout
end try
EOF
}

split_pane() {  # $1 = session id to split below, $2 = new pane ordinal
    osascript - "$win" "$1" "${TILE_ENV}$TILE_HOME/bin/cargo-tile-slot $2" <<'EOF'
on run argv
	set winId to (item 1 of argv) as integer
	set sid to item 2 of argv
	set cmd to item 3 of argv
	tell application "iTerm2"
		repeat with t in tabs of window id winId
			repeat with s in sessions of t
				if (id of s) is equal to sid then
					tell s to set ns to (split horizontally with default profile command cmd)
					return id of ns
				end if
			end repeat
		end repeat
	end tell
	error "session not found"
end run
EOF
}

close_pane() {  # $1 = session id
    # timeout, because a close confirmation prompt would otherwise hold
    # the layout lock forever and stall every later add and decay
    osascript - "$win" "$1" <<'EOF'
on run argv
	set winId to (item 1 of argv) as integer
	set sid to item 2 of argv
	try
		with timeout of 10 seconds
			tell application "iTerm2"
				repeat with t in tabs of window id winId
					repeat with s in sessions of t
						if (id of s) is equal to sid then
							close s
							return
						end if
					end repeat
				end repeat
			end tell
		end timeout
	end try
end run
EOF
}

# create or reuse the grid window and hand back "winid headsid". The id
# comes back BEFORE any split runs so the caller can record it at once:
# a window created inside a script that later errors — or whose Apple
# event reply times out, which is what produced the duplicate grid
# windows — is otherwise alive but untracked, and the next add makes
# another one.
ensure_window() {  # $1 = command for the head pane
    local w="" out
    [[ -f "$STATE/window" ]] && w=$(<"$STATE/window")
    out=$(osascript - "$w" "$1" <<'EOF'
on run argv
	set winId to item 1 of argv
	set firstCmd to item 2 of argv
	tell application "iTerm2"
		set w to missing value
		if winId is not "" then
			try
				set w to window id (winId as integer)
				tell w to create tab with default profile command firstCmd
			on error
				set w to missing value
			end try
		end if
		if w is missing value then
			with timeout of 60 seconds
				set w to (create window with default profile command firstCmd)
			end timeout
			-- size a fresh window to 75% of the screen, centered
			set sw to 1440
			set sh to 900
			try
				with timeout of 2 seconds
					tell application "Finder" to set sb to bounds of window of desktop
				end timeout
				set sw to item 3 of sb
				set sh to item 4 of sb
			end try
			set winW to sw * 3 div 4
			set winH to sh * 3 div 4
			set x0 to (sw - winW) div 2
			set y0 to (sh - winH) div 2
			try
				set bounds of w to {x0, y0, x0 + winW, y0 + winH}
			end try
		end if
		return ((id of w) as text) & " " & (id of (current session of (current tab of w)))
	end tell
end run
EOF
    ) && [[ -n "$out" ]] && { print -r -- "$out"; return 0 }
    adopt_stray "$w"
}

# a `create window` whose Apple event reply timed out still made the
# window — find it by the marker its panes set rather than creating a
# second one. The marker needs a moment to arrive, hence the retries.
adopt_stray() {  # $1 = window id to leave alone
    local out i
    for i in {1..5}; do
        out=$(osascript - "$1" "$TILE_TAG" <<'EOF'
on run argv
	set keepId to item 1 of argv
	set myTag to item 2 of argv
	tell application "iTerm2"
		repeat with w in windows
			if ((id of w) as text) is not keepId then
				if (count of tabs of w) is 1 then
					set t to item 1 of tabs of w
					if (count of sessions of t) is 1 then
						set s to item 1 of sessions of t
						set v to missing value
						try
							tell s to set v to (variable named "user.cargotile")
						end try
						if v is myTag then
							return ((id of w) as text) & " " & (id of s)
						end if
					end if
				end if
			end if
		end repeat
	end tell
	return ""
end run
EOF
        ) || out=""
        [[ -n "$out" ]] && { print -r -- "$out"; return 0 }
        sleep 1
    done
    return 1
}

# close superseded grid windows: any window whose every session is a pane
# of THIS instance (they tag themselves with the user.cargotile variable;
# pressing q clears the tag, so a window the user took over survives).
# The tag carries the root, so a test grid running beside the real one is
# not mistaken for a window this instance superseded and closed.
sweep_orphans() {  # $1 = window id to keep
    [[ -n "${1:-}" ]] || return 0
    osascript - "$1" "$TILE_TAG" <<'EOF'
on run argv
	set keepId to item 1 of argv
	set myTag to item 2 of argv
	set doomed to {}
	tell application "iTerm2"
		repeat with w in windows
			if ((id of w) as text) is not keepId then
				set marked to 0
				set total to 0
				repeat with t in tabs of w
					repeat with s in sessions of t
						set total to total + 1
						set v to missing value
						try
							tell s to set v to (variable named "user.cargotile")
						end try
						if v is myTag then set marked to marked + 1
					end repeat
				end repeat
				if total > 0 and marked is total then
					copy (id of w) to end of doomed
				end if
			end if
		end repeat
		-- close the sessions one at a time and let the window go when
		-- its last one does: `close window` (and `close tab`) trips
		-- iTerm2's "confirm closing multiple sessions" sheet, which
		-- blocks the Apple event until someone clicks it
		repeat with d in doomed
			try
				with timeout of 20 seconds
					repeat 60 times
						set w2 to missing value
						try
							set w2 to window id (d as integer)
						end try
						if w2 is missing value then exit repeat
						set victim to missing value
						repeat with t in tabs of w2
							repeat with s in sessions of t
								set victim to s
								exit repeat
							end repeat
							if victim is not missing value then exit repeat
						end repeat
						if victim is missing value then exit repeat
						close victim
					end repeat
				end timeout
			end try
		end repeat
	end tell
end run
EOF
}

# split the head pane into the k-column grid; echoes the session ids in
# snake order. It runs against a window whose id is already recorded, so
# a failure here costs a retry, never a leaked window.
build_layout() {  # $1 win, $2 head session, $3 m, then SHAPE, then cmds
    osascript - "$@" <<'EOF'
on run argv
	set winId to (item 1 of argv) as integer
	set headId to item 2 of argv
	set m to (item 3 of argv) as integer
	set hs to {}
	repeat with i from 4 to (3 + m)
		copy ((item i of argv) as integer) to end of hs
	end repeat
	set cmds to {}
	repeat with i from (4 + m) to (count of argv)
		copy (item i of argv) to end of cmds
	end repeat

	tell application "iTerm2"
		set w to window id winId
		set head to missing value
		repeat with t in tabs of w
			repeat with s in sessions of t
				if (id of s) is equal to headId then set head to s
			end repeat
		end repeat
		if head is missing value then error "head session gone"

		-- columns via vertical splits; column c starts at cmds index
		-- 1 + sum of hs[1..c-1]
		set colHeads to {head}
		set starts to {1}
		set acc to 1
		repeat with c from 2 to m
			set acc to acc + (item (c - 1) of hs)
			copy acc to end of starts
			set prev to item (c - 1) of colHeads
			tell prev to set ns to (split vertically with default profile command (item acc of cmds))
			copy ns to end of colHeads
		end repeat

		-- fill each column's rows top to bottom, collecting session
		-- ids in snake order
		set allSess to {}
		repeat with c from 1 to m
			set cur to item c of colHeads
			copy cur to end of allSess
			repeat with r from 2 to (item c of hs)
				tell cur to set cur to (split horizontally with default profile command (item ((item c of starts) + r - 1) of cmds))
				copy cur to end of allSess
			end repeat
		end repeat

		-- session refs are positional, so resolve ids BEFORE closing
		-- the old panes shifts every index
		set out to ""
		set newIds to {}
		repeat with s in allSess
			set out to out & (id of s) & " "
			copy (id of s) to end of newIds
		end repeat

		-- drop the previous layout: close every session that is not part
		-- of the new grid, one at a time. Closing the whole tab would
		-- trip iTerm2's "confirm closing multiple sessions" sheet and
		-- hang the Apple event; re-scanning each pass avoids the index
		-- invalidation that produced "Can't get tab 2 of window id".
		try
			with timeout of 20 seconds
				repeat 60 times
					set victim to missing value
					repeat with t in tabs of w
						repeat with s in sessions of t
							if (id of s) is not in newIds then
								set victim to s
								exit repeat
							end if
						end repeat
						if victim is not missing value then exit repeat
					end repeat
					if victim is missing value then exit repeat
					close victim
				end repeat
			end timeout
		end try
	end tell

	-- equalize pane sizes (needs Automation+Accessibility; best-effort)
	try
		with timeout of 3 seconds
			tell application "System Events" to tell process "iTerm2"
				click menu item "Arrange Split Panes Evenly" of menu "View" of menu bar 1
			end tell
		end timeout
	end try

	return out
end run
EOF
}

# tear down and rebuild the whole layout for N tiles (window creation,
# recovery, and column growth — the only cases a session split can't
# reach)
full_rebuild() {
    shape_for $N
    local m=${#SHAPE}
    typeset -a cmds nords
    cmds=("${TILE_ENV}$TILE_HOME/bin/cargo-tile-summary")
    nords=(1)
    local j o
    for (( j = 2; j <= N; j++ )); do
        o=$(next_ord)
        nords+=($o)
        cmds+=("${TILE_ENV}$TILE_HOME/bin/cargo-tile-slot $o")
    done
    local head
    head=$(ensure_window "${cmds[1]}") || return 1
    win="${head%% *}"
    local hsid="${head##* }"
    # record it now: everything past this point is retryable, and an
    # unrecorded window can never be found or closed again
    print -r -- "$win" > "$STATE/window"
    sweep_orphans "$win" >/dev/null 2>&1
    local out
    out=$(build_layout "$win" "$hsid" "$m" "${SHAPE[@]}" "${cmds[@]}") || return 1
    typeset -a parts
    parts=(${=out})
    cols=()
    local ci pos=1 line
    for (( ci = 1; ci <= m; ci++ )); do
        line=""
        for (( j = 1; j <= SHAPE[ci]; j++ )); do
            line+="${line:+ }${nords[$pos]}:${parts[pos]}"
            (( pos += 1 ))
        done
        cols+=("$line")
    done
    print -rl -- "${cols[@]}" > "$STATE/layout"
    rm -f "$STATE"/panemap/*(N)
    rm -f "$STATE/rebuild-needed"
}

# grow (and reshape) the existing window one split/close at a time
converge() {
    shape_for $N
    local m=${#SHAPE}
    if (( ${#cols} == 0 )) || (( m > ${#cols} )); then
        full_rebuild
        return
    fi
    local ci changed=0 ord nsid base want
    typeset -a entries
    for (( ci = 1; ci <= ${#cols}; ci++ )); do
        entries=(${=cols[$ci]})
        want=${SHAPE[$ci]:-0}
        while (( ${#entries} < want )); do
            ord=$(next_ord)
            base="${entries[-1]#*:}"
            if ! nsid=$(split_pane "$base" "$ord"); then
                # a split that misses means the layout no longer matches
                # the window — start over rather than leave them apart
                full_rebuild
                return
            fi
            entries+=("$ord:$nsid")
            changed=1
        done
        while (( ${#entries} > want )); do
            close_pane "${entries[-1]#*:}"
            rm -f "$STATE/panemap/${entries[-1]%%:*}"
            entries=("${(@)entries[1,-2]}")
            changed=1
        done
        cols[$ci]="${entries[*]}"
    done
    cols=("${(@)cols:#}")
    if (( changed )); then
        print -rl -- "${cols[@]}" > "$STATE/layout"
        even_arrange
    fi
}

# close the one trailing pane, once its DECAY_SECS is up. That window
# runs from whichever came later: the moment its own content left (its
# map file is rewritten only when what the pane shows changes, so its
# mtime is that moment) or the moment it became the trailing pane —
# decay-last, stamped by the close in front of it. So a refilled pane
# starts over, and a row of idle panes drops off one per DECAY_SECS
# rather than all at once.
do_decay() {
    (( P > N )) || return 0
    local li=${#cols}
    typeset -a entries
    entries=(${=cols[$li]})
    # runs pack toward the front, so the last pane should be idle — but
    # never close one that is showing something (an idle map file still
    # holds print's newline, so test the content, not the size)
    local ord="${entries[-1]%%:*}"
    local mf="$STATE/panemap/$ord" lmap=""
    [[ -f "$mf" ]] && lmap=$(<"$mf")
    [[ -n "$lmap" ]] && return 0
    local now mt dl
    now=$(date +%s)
    # no map file yet (a pane converge just made): sync_maps writes one
    # on the way out and it decays a full window later
    mt=$(stat -f %m "$mf" 2>/dev/null) || mt=$now
    dl=$(stat -f %m "$STATE/decay-last" 2>/dev/null) || dl=0
    (( mt > dl )) && dl=$mt
    (( now - dl >= DECAY_SECS )) || return 0
    close_pane "${entries[-1]#*:}"
    rm -f "$mf"
    entries=("${(@)entries[1,-2]}")
    if (( ${#entries} == 0 )); then
        cols=("${(@)cols[1,-2]}")
    else
        cols[$li]="${entries[*]}"
    fi
    print -rl -- "${cols[@]}" > "$STATE/layout"
    # this is also when the pane behind it became the trailing one, and
    # so when its own DECAY_SECS starts
    touch "$STATE/decay-last"
    even_arrange
}

# the real session ids of the window, one per line; fails if it is gone
win_sids() {
    osascript - "$win" <<'EOF'
on run argv
	set winId to (item 1 of argv) as integer
	set out to ""
	tell application "iTerm2"
		repeat with t in tabs of window id winId
			repeat with s in sessions of t
				set out to out & (id of s) & linefeed
			end repeat
		end repeat
	end tell
	return out
end run
EOF
}

# --close tears the whole instance down: every window whose panes all
# carry this instance's tag goes, which is the same test the orphan sweep
# uses, so a window the user took over with q is left alone. Handled
# before the liveness check below, which would otherwise rebuild the very
# grid we are trying to close.
if [[ "$mode" == close ]]; then
    # forget the window first: a summary that wakes while the sweep is
    # still running would otherwise see an empty layout, ask for a
    # rebuild, and stand a fresh grid up behind us
    rm -f "$STATE/window" "$STATE/layout" "$STATE/rebuild-needed"
    rm -f "$STATE"/slots/*(N) "$STATE"/panemap/*(N) "$STATE"/target/*(N)
    sweep_orphans 0 >/dev/null 2>&1
    exit 0
fi

# does the window still exist, and does the layout file describe it?
# splitting against a stale layout puts panes in the wrong place (and
# the summary can't map runs to panes), so any mismatch rebuilds
win=""
[[ -f "$STATE/window" ]] && win=$(<"$STATE/window")
alive=0
layout_ok=0
typeset -a realsids
if [[ -n "$win" ]] && sids=$(win_sids 2>/dev/null); then
    alive=1
    realsids=(${(f)sids})
    typeset -a lsids
    lsids=()
    for c in "${cols[@]}"; do
        for e in ${=c}; do lsids+=("${e#*:}"); done
    done
    [[ "${(j: :)${(o)lsids}}" == "${(j: :)${(o)realsids}}" ]] && layout_ok=1
fi

if (( ! alive || ! layout_ok )); then
    full_rebuild
elif [[ "$mode" == decay ]]; then
    do_decay
elif (( N > P )); then
    converge
fi
# --check is the recovery path: reap grid windows left behind by an
# earlier rebuild even when this run had no layout work to do
if [[ "$mode" == check && -f "$STATE/window" ]]; then
    sweep_orphans "$(<"$STATE/window")" >/dev/null 2>&1
fi
sync_maps
