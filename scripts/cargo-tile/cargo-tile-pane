#!/bin/zsh
# rev 43 — bump this comment in every cargo-tile source file on each change
# Assign runs to the cargo-tile pane layout.
#   cargo-tile-pane <log>           add a run
#   cargo-tile-pane --remove <log>  drop a finished run
#   cargo-tile-pane --check         converge layout (deferred work, recovery)
#   cargo-tile-pane --decay         close one trailing idle pane
#
# Tile 1 is the summary; runs fill tiles 2..N in snake order (down
# column 1, then column 2, ...). For N tiles, k = ceil(sqrt(N)):
# columns hold k tiles each and the last column's panes split the full
# column height evenly. Panes are added one split at a time as tiles
# arrive; a new COLUMN can't be made from a session split, so only
# column growth (N = 3, 7, 13, 21, 31) rebuilds the window. When runs
# leave, content shifts up (slots stay packed), trailing panes go idle
# in place, and --decay closes one per minute so they can be refilled
# without churn.
#
# state/slots/<pos>  packed run logs, positions 2.. in snake order
# state/layout       one line per column: "ord:sessionid ..." top-down
# state/panemap/<o>  the log pane <o> shows (empty = idle); watched by
#                    cargo-tile-slot <o>
set -u

TILE_HOME="${CARGO_TILE_HOME:-$HOME/.cargo-tile}"
STATE=/tmp/cargo-tile/state
ERRLOG=/tmp/cargo-tile/pane-errors.log

mode=add
case "${1:-}" in
    --remove) mode=remove; shift ;;
    --check) mode=check; shift ;;
    --decay) mode=decay; shift ;;
esac
LOG="${1:-}"
mkdir -p "$STATE/slots" "$STATE/panemap"

# serialize concurrent invocations — running two of these at once
# interleaves osascript calls and corrupts the layout, so on timeout we
# DROP the event (a later --check self-heals) rather than run unlocked
LOCK="$STATE/lock"
locked=0
for i in {1..150}; do
    if mkdir "$LOCK" 2>/dev/null; then
        locked=1
        print -r -- $$ > "$LOCK/pid"
        break
    fi
    # a holder that crashed without its EXIT trap leaves the lock
    # behind — steal only when the recorded holder is dead (a slow
    # full_rebuild legitimately holds it well past any age threshold).
    # Sandboxed callers never steal: the sandbox blocks probing
    # unrelated pids, so kill -0 reports a live holder as dead.
    if (( i % 20 == 0 )) && /bin/ps -p $$ >/dev/null 2>&1; then
        hpid=""
        [[ -f "$LOCK/pid" ]] && hpid=$(<"$LOCK/pid")
        if [[ "$hpid" == <-> ]]; then
            kill -0 "$hpid" 2>/dev/null || rm -rf "$LOCK" 2>/dev/null
        else
            # no pid recorded (holder died mid-acquire): fall back to age
            lage=$(( $(date +%s) - $(stat -f %m "$LOCK" 2>/dev/null || date +%s) ))
            (( lage > 60 )) && rm -rf "$LOCK" 2>/dev/null
        fi
    fi
    sleep 0.1
done
if (( ! locked )); then
    touch "$STATE/rebuild-needed"
    exit 0
fi
# rm -rf, not rmdir: the pid file inside makes rmdir fail silently, which
# leaks the lock on every release — sandboxed callers can't steal, so their
# adds then time out forever
trap 'rm -rf "$LOCK" 2>/dev/null' EXIT

# collect active slots (slot -> log), dropping stale entries
typeset -A slotlog
for f in "$STATE"/slots/*(N); do
    [[ -s "$f" ]] || continue
    l=$(<"$f")
    if [[ -f "$l" ]]; then
        slotlog[${f:t}]="$l"
    else
        : > "$f"
    fi
done

if [[ "$mode" == remove ]]; then
    for s in "${(k)slotlog[@]}"; do
        if [[ "${slotlog[$s]}" == "$LOG" ]]; then
            : > "$STATE/slots/$s"
            unset "slotlog[$s]"
        fi
    done
    ( sleep 0.7; rm -f "$LOG" ) &!
fi

# keep runs packed toward the front: close any holes left by removes
# (or stale entries) by shifting later runs up, preserving order
typeset -a packed
packed=()
for s in ${(kon)slotlog}; do packed+=("${slotlog[$s]}"); done
slotlog=()
i=2
for l in "${packed[@]}"; do
    cur=""
    [[ -s "$STATE/slots/$i" ]] && cur=$(<"$STATE/slots/$i")
    [[ "$cur" == "$l" ]] || print -r -- "$l" > "$STATE/slots/$i"
    slotlog[$i]="$l"
    (( i += 1 ))
done
for f in "$STATE"/slots/*(N); do
    (( ${f:t} >= i )) && [[ -s "$f" ]] && : > "$f"
done

if [[ "$mode" == add && -n "$LOG" ]]; then
    # a shim add can race --check adoption of the same run — never
    # register a log twice (two panes would tail the same output)
    dup=0
    for s in "${(k)slotlog[@]}"; do
        [[ "${slotlog[$s]}" == "$LOG" ]] && { dup=1; break }
    done
    slot=$(( ${#slotlog} + 2 ))
    if (( ! dup && slot <= 36 )); then
        print -r -- "$LOG" > "$STATE/slots/$slot"
        slotlog[$slot]="$LOG"
    fi
fi

N=$(( ${#slotlog} + 1 ))  # + summary tile
(( N > 36 )) && N=36

# current pane layout
typeset -a cols colw
[[ -s "$STATE/layout" ]] && cols=("${(@f)$(<"$STATE/layout")}")
P=0
for c in "${cols[@]}"; do
    # split first: ${#${=c}} on a one-word line is its string length, not 1
    colw=(${=c})
    (( P += ${#colw} ))
done

# column heights for $1 tiles -> SHAPE
shape_for() {
    local n=$1 k=1 rem
    while (( k * k < n )); do (( k += 1 )); done
    typeset -ga SHAPE
    SHAPE=()
    rem=$n
    while (( rem > 0 )); do
        if (( rem >= k )); then
            SHAPE+=($k)
            (( rem -= k ))
        else
            SHAPE+=($rem)
            rem=0
        fi
    done
}

# pane ordinals in snake order from $cols -> ORDS
flatten_ords() {
    typeset -ga ORDS
    ORDS=()
    local c e
    for c in "${cols[@]}"; do
        for e in ${=c}; do ORDS+=("${e%%:*}"); done
    done
}

# point every pane's map at the run for its position (pure file writes,
# safe from any caller); panes past the run list go idle
sync_maps() {
    flatten_ords
    local i tgt curm mf
    for (( i = 2; i <= ${#ORDS}; i++ )); do
        tgt="${slotlog[$i]:-}"
        mf="$STATE/panemap/${ORDS[$i]}"
        curm=""
        [[ -s "$mf" ]] && curm=$(<"$mf")
        [[ "$curm" == "$tgt" ]] || print -r -- "$tgt" > "$mf"
    done
}

# sandboxed caller (cargo from a Claude Code shell — detectable because
# the sandbox blocks exec of /bin/ps): slot and map files are plain
# /tmp writes, but osascript can't reach iTerm2, so pane creation and
# recovery are deferred to the summary pane via the rebuild-needed
# marker
if ! /bin/ps -p $$ >/dev/null 2>&1; then
    sync_maps
    if [[ ! -f "$STATE/window" ]] || (( N > P )); then
        touch "$STATE/rebuild-needed"
    fi
    exit 0
fi

# a --check is the self-heal entry point: re-register any live run
# whose add was dropped (lock contention) or whose slot was lost
if [[ "$mode" == check ]]; then
    typeset -A haslog
    for s in "${(k)slotlog[@]}"; do haslog[${slotlog[$s]}]=1; done
    for lg in /tmp/cargo-tile/run-*-*.log(N); do
        [[ -n "${haslog[$lg]:-}" ]] && continue
        pid="${${lg:t:r}##*-}"
        [[ "$pid" == <-> ]] || continue
        kill -0 "$pid" 2>/dev/null || continue
        slot=$(( ${#slotlog} + 2 ))
        (( slot <= 36 )) || break
        print -r -- "$lg" > "$STATE/slots/$slot"
        slotlog[$slot]="$lg"
        haslog[$lg]=1
    done
    N=$(( ${#slotlog} + 1 ))
    (( N > 36 )) && N=36
fi

next_ord() {
    local o=1
    [[ -s "$STATE/pane-seq" ]] && o=$(<"$STATE/pane-seq")
    (( o += 1 ))
    print -r -- "$o" > "$STATE/pane-seq"
    print -r -- "$o"
}

even_arrange() {
    osascript <<'EOF' 2>/dev/null
try
	with timeout of 3 seconds
		tell application "System Events" to tell process "iTerm2"
			click menu item "Arrange Split Panes Evenly" of menu "View" of menu bar 1
		end tell
	end timeout
end try
EOF
}

split_pane() {  # $1 = session id to split below, $2 = new pane ordinal
    osascript - "$win" "$1" "$TILE_HOME/bin/cargo-tile-slot $2" <<'EOF'
on run argv
	set winId to (item 1 of argv) as integer
	set sid to item 2 of argv
	set cmd to item 3 of argv
	tell application "iTerm2"
		repeat with t in tabs of window id winId
			repeat with s in sessions of t
				if (id of s) is equal to sid then
					tell s to set ns to (split horizontally with default profile command cmd)
					return id of ns
				end if
			end repeat
		end repeat
	end tell
	error "session not found"
end run
EOF
}

close_pane() {  # $1 = session id
    osascript - "$win" "$1" <<'EOF'
on run argv
	set winId to (item 1 of argv) as integer
	set sid to item 2 of argv
	tell application "iTerm2"
		repeat with t in tabs of window id winId
			repeat with s in sessions of t
				if (id of s) is equal to sid then
					close s
					return
				end if
			end repeat
		end repeat
	end tell
end run
EOF
}

# tear down and rebuild the whole layout for N tiles (window creation,
# recovery, and column growth — the only cases a session split can't
# reach)
full_rebuild() {
    shape_for $N
    local m=${#SHAPE}
    typeset -a cmds nords
    cmds=("$TILE_HOME/bin/cargo-tile-summary")
    nords=(1)
    local j o
    for (( j = 2; j <= N; j++ )); do
        o=$(next_ord)
        nords+=($o)
        cmds+=("$TILE_HOME/bin/cargo-tile-slot $o")
    done
    local w=""
    [[ -f "$STATE/window" ]] && w=$(<"$STATE/window")
    typeset -a known stale
    known=()
    stale=()
    [[ -f "$STATE/windows-created" ]] && known=("${(@f)$(<"$STATE/windows-created")}")
    local kn
    for kn in "${known[@]}"; do
        [[ -n "$kn" && "$kn" != "$w" ]] && stale+=("$kn")
    done
    local out
    out=$(osascript - "$w" "${#stale}" "${stale[@]}" "$m" "${SHAPE[@]}" "${cmds[@]}" <<'EOF'
on run argv
	set winId to item 1 of argv
	set nStale to (item 2 of argv) as integer
	set staleIds to {}
	repeat with i from 3 to (2 + nStale)
		copy (item i of argv) to end of staleIds
	end repeat
	set base to 2 + nStale
	set m to (item (base + 1) of argv) as integer
	set hs to {}
	repeat with i from (base + 2) to (base + 1 + m)
		copy ((item i of argv) as integer) to end of hs
	end repeat
	set cbase to base + 1 + m
	set cmds to {}
	repeat with i from (cbase + 1) to (count of argv)
		copy (item i of argv) to end of cmds
	end repeat

	set firstCmd to item 1 of cmds
	tell application "iTerm2"
		set w to missing value
		set created to false
		if winId is not "" then
			try
				set w to window id (winId as integer)
				tell w to create tab with default profile command firstCmd
			on error
				set w to missing value
			end try
		end if
		if w is missing value then
			set w to (create window with default profile command firstCmd)
			set created to true
		end if

		-- size a fresh window to 75% of the screen, centered
		if created then
			set sw to 1440
			set sh to 900
			try
				with timeout of 2 seconds
					tell application "Finder" to set sb to bounds of window of desktop
				end timeout
				set sw to item 3 of sb
				set sh to item 4 of sb
			end try
			set winW to sw * 3 div 4
			set winH to sh * 3 div 4
			set x0 to (sw - winW) div 2
			set y0 to (sh - winH) div 2
			try
				set bounds of w to {x0, y0, x0 + winW, y0 + winH}
			end try
		end if

		-- close superseded grid windows
		repeat with sid in staleIds
			try
				with timeout of 5 seconds
					close window id (sid as integer)
				end timeout
			end try
		end repeat

		-- columns via vertical splits; column c starts at cmds index
		-- 1 + sum of hs[1..c-1]
		set t to current tab of w
		set colHeads to {current session of t}
		set starts to {1}
		set acc to 1
		repeat with c from 2 to m
			set acc to acc + (item (c - 1) of hs)
			copy acc to end of starts
			set prev to item (c - 1) of colHeads
			tell prev to set ns to (split vertically with default profile command (item acc of cmds))
			copy ns to end of colHeads
		end repeat

		-- fill each column's rows top to bottom, collecting session
		-- ids in snake order
		set allSess to {}
		repeat with c from 1 to m
			set cur to item c of colHeads
			copy cur to end of allSess
			repeat with r from 2 to (item c of hs)
				tell cur to set cur to (split horizontally with default profile command (item ((item c of starts) + r - 1) of cmds))
				copy cur to end of allSess
			end repeat
		end repeat

		-- session refs are positional (tab N), so resolve ids BEFORE
		-- closing the old tab shifts every index
		set out to (id of w) as text
		repeat with s in allSess
			set out to out & " " & (id of s)
		end repeat

		-- drop the previous layout (best-effort; never hang on a prompt)
		try
			with timeout of 5 seconds
				tell w
					repeat while (count of tabs) > 1
						close first tab
					end repeat
				end tell
			end timeout
		end try
	end tell

	-- equalize pane sizes (needs Automation+Accessibility; best-effort)
	try
		with timeout of 3 seconds
			tell application "System Events" to tell process "iTerm2"
				click menu item "Arrange Split Panes Evenly" of menu "View" of menu bar 1
			end tell
		end timeout
	end try

	return out
end run
EOF
    ) || return 1
    typeset -a parts
    parts=(${=out})
    print -r -- "${parts[1]}" > "$STATE/window"
    print -r -- "${parts[1]}" > "$STATE/windows-created"
    cols=()
    local ci pos=1 line
    for (( ci = 1; ci <= m; ci++ )); do
        line=""
        for (( j = 1; j <= SHAPE[ci]; j++ )); do
            line+="${line:+ }${nords[$pos]}:${parts[pos+1]}"
            (( pos += 1 ))
        done
        cols+=("$line")
    done
    print -rl -- "${cols[@]}" > "$STATE/layout"
    rm -f "$STATE"/panemap/*(N)
    rm -f "$STATE/rebuild-needed"
}

# grow (and reshape) the existing window one split/close at a time
converge() {
    shape_for $N
    local m=${#SHAPE}
    if (( ${#cols} == 0 )) || (( m > ${#cols} )); then
        full_rebuild
        return
    fi
    local ci changed=0 ord nsid base want
    typeset -a entries
    for (( ci = 1; ci <= ${#cols}; ci++ )); do
        entries=(${=cols[$ci]})
        want=${SHAPE[$ci]:-0}
        while (( ${#entries} < want )); do
            ord=$(next_ord)
            base="${entries[-1]#*:}"
            if ! nsid=$(split_pane "$base" "$ord"); then
                # a split that misses means the layout no longer matches
                # the window — start over rather than leave them apart
                full_rebuild
                return
            fi
            entries+=("$ord:$nsid")
            changed=1
        done
        while (( ${#entries} > want )); do
            close_pane "${entries[-1]#*:}"
            rm -f "$STATE/panemap/${entries[-1]%%:*}"
            entries=("${(@)entries[1,-2]}")
            changed=1
        done
        cols[$ci]="${entries[*]}"
    done
    cols=("${(@)cols:#}")
    if (( changed )); then
        print -rl -- "${cols[@]}" > "$STATE/layout"
        even_arrange
    fi
}

# close one trailing pane — only ever called when it is idle (runs are
# packed toward the front, so with P > N the last pane shows nothing)
do_decay() {
    (( P > N )) || return 0
    local li=${#cols}
    typeset -a entries
    entries=(${=cols[$li]})
    # runs pack toward the front, so the last pane should be idle — but
    # never close one that is showing something (an idle map file still
    # holds print's newline, so test the content, not the size)
    local lmf="$STATE/panemap/${entries[-1]%%:*}" lmap=""
    [[ -f "$lmf" ]] && lmap=$(<"$lmf")
    [[ -n "$lmap" ]] && return 0
    close_pane "${entries[-1]#*:}"
    rm -f "$STATE/panemap/${entries[-1]%%:*}"
    entries=("${(@)entries[1,-2]}")
    if (( ${#entries} == 0 )); then
        cols=("${(@)cols[1,-2]}")
    else
        cols[$li]="${entries[*]}"
    fi
    print -rl -- "${cols[@]}" > "$STATE/layout"
    touch "$STATE/decay-last"
    even_arrange
}

# the real session ids of the window, one per line; fails if it is gone
win_sids() {
    osascript - "$win" <<'EOF'
on run argv
	set winId to (item 1 of argv) as integer
	set out to ""
	tell application "iTerm2"
		repeat with t in tabs of window id winId
			repeat with s in sessions of t
				set out to out & (id of s) & linefeed
			end repeat
		end repeat
	end tell
	return out
end run
EOF
}

# does the window still exist, and does the layout file describe it?
# splitting against a stale layout puts panes in the wrong place (and
# the summary can't map runs to panes), so any mismatch rebuilds
win=""
[[ -f "$STATE/window" ]] && win=$(<"$STATE/window")
alive=0
layout_ok=0
typeset -a realsids
if [[ -n "$win" ]] && sids=$(win_sids 2>/dev/null); then
    alive=1
    realsids=(${(f)sids})
    typeset -a lsids
    lsids=()
    for c in "${cols[@]}"; do
        for e in ${=c}; do lsids+=("${e#*:}"); done
    done
    [[ "${(j: :)${(o)lsids}}" == "${(j: :)${(o)realsids}}" ]] && layout_ok=1
fi

if (( ! alive || ! layout_ok )); then
    full_rebuild
elif [[ "$mode" == decay ]]; then
    do_decay
elif (( N > P )); then
    converge
fi
sync_maps
