#!/bin/zsh
# rev 36 — bump this comment in every cargo-tile source file on each change
# One layout pane, identified by a permanent ordinal. Watches its map
# file (the log it should show) and displays it via tail; shows an idle
# placeholder when the map is empty. Content reflows across panes as
# the layout changes — the pane itself only ever swaps what it tails.
set -u

REVISION=36

TILE_HOME="${CARGO_TILE_HOME:-$HOME/.cargo-tile}"
STATE=/tmp/cargo-tile/state
N="$1"
SLOTF="$STATE/panemap/$N"

# self-refresh: re-exec when the source file's rev comment changes.
# $0 inside a zsh function is the function name, so capture it here.
SELF="$0"
src_rev() { sed -n '2s/^# rev \([0-9]*\).*/\1/p' "$SELF" 2>/dev/null; }

tailpid=""
cur="__init__"
last_rev_check=0

show_idle() {
    # OSC 0 sets the session name (what iTerm displays), not just the
    # window title
    printf '\033]0;· %s ·\007' "$N"
    printf '\033[H\033[2J\033[3J'
    printf '\n  \033[2m· slot %s idle ·\033[0m\n' "$N"
}

cleanup() {
    [[ -n "$tailpid" ]] && kill "$tailpid" 2>/dev/null
    exit 0
}
trap cleanup INT TERM HUP

while true; do
    # throttled so the 0.3s loop doesn't fork sed every pass
    if (( SECONDS - last_rev_check >= 5 )); then
        last_rev_check=$SECONDS
        rev="$(src_rev)"
        if [[ -n "$rev" && "$rev" != "$REVISION" ]]; then
            [[ -n "$tailpid" ]] && kill "$tailpid" 2>/dev/null
            exec "$SELF" "$N"
        fi
    fi
    new=""
    [[ -s "$SLOTF" ]] && new=$(<"$SLOTF")
    if [[ "$new" != "$cur" ]]; then
        [[ -n "$tailpid" ]] && { kill "$tailpid" 2>/dev/null; wait "$tailpid" 2>/dev/null }
        tailpid=""
        cur="$new"
        if [[ -n "$cur" && -f "$cur" ]]; then
            # name the pane after the run's full command (log line 1
            # carries it in an OSC 2 escape)
            l1=$(head -1 "$cur" 2>/dev/null)
            t="${l1#*\]2;}"
            t="${t%%$'\a'*}"
            [[ -n "$t" && "$t" != "$l1" ]] || t="slot $N"
            printf '\033]0;%s\007' "$t"
            printf '\033[H\033[2J\033[3J'
            /usr/bin/tail -n +1 -F "$cur" 2>/dev/null &
            tailpid=$!
        else
            show_idle
        fi
    fi
    # q drops this pane to an interactive shell (watcher is gone until
    # the next grid rebuild)
    if [[ -t 0 ]]; then
        key=""
        read -s -t 0.3 -k 1 key 2>/dev/null
        if [[ "$key" == q ]]; then
            [[ -n "$tailpid" ]] && kill "$tailpid" 2>/dev/null
            printf '\033[H\033[2J\033[3J'
            exec /bin/zsh -il
        fi
    else
        sleep 0.3
    fi
done
