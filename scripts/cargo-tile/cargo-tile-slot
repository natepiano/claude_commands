#!/bin/zsh
# rev 53 — bump this comment in every cargo-tile source file on each change
# One layout pane, identified by a permanent ordinal. Watches its map
# file (the log it should show) and displays it via tail; shows an idle
# placeholder when the map is empty. Content reflows across panes as
# the layout changes — the pane itself only ever swaps what it tails.
set -u

REVISION=53

TILE_HOME="${CARGO_TILE_HOME:-$HOME/.cargo-tile}"
STATE=/tmp/cargo-tile/state

# idle panes close this many seconds after their content leaves them —
# cargo-tile.conf is the one place it is set, so pane, slot and summary
# cannot drift apart
source "${0:A:h}/conf.zsh"
DECAY_SECS=$(tile_conf decay_secs 15)

N="$1"
SLOTF="$STATE/panemap/$N"

# self-refresh: re-exec when the source file's rev comment changes.
# $0 inside a zsh function is the function name, so capture it here.
SELF="$0"
src_rev() { sed -n '2s/^# rev \([0-9]*\).*/\1/p' "$SELF" 2>/dev/null; }

# tag the session so the orphan sweep can tell a cargo-tile grid window
# from one the user owns; pressing q below clears the tag (base64 "grid")
printf '\033]1337;SetUserVar=cargotile=%s\007' Z3JpZA==

tailpid=""
cur="__init__"
last_rev_check=0
last_idle_tick=0

# countdown for the trailing pane — the only one decay can close, so
# the only one with a deadline to show. Its DECAY_SECS runs from
# whichever came later: the moment its own content left (the map file
# is rewritten only when what the pane shows changes, so its mtime is
# that moment) or the moment it became the trailing pane, which is the
# close in front of it stamping decay-last. Idle panes further up wait
# silently and start their own DECAY_SECS when that close lands, so one
# pane drops off every DECAY_SECS. Panes inside the runs+1 target are
# keepers awaiting refill and show nothing.
idle_line() {
    [[ -s "$STATE/layout" ]] || return 0
    local -a lw ords
    local lline e i mine=0 P
    ords=()
    while IFS= read -r lline; do
        lw=(${=lline})
        for e in "${lw[@]}"; do ords+=("${e%%:*}"); done
    done < "$STATE/layout"
    P=${#ords}
    for (( i = 1; i <= P; i++ )); do
        [[ "${ords[$i]}" == "$N" ]] && mine=$i
    done
    (( mine == P && P > 1 )) || return 0
    local shown=0 mf
    for mf in "$STATE"/panemap/*(N); do
        [[ -n "$(<"$mf")" ]] && (( shown += 1 ))
    done
    (( P - shown - 1 > 0 )) || return 0
    local now mt dl
    now=$(date +%s)
    mt=$(stat -f %m "$STATE/panemap/$N" 2>/dev/null) || mt=$now
    dl=$(stat -f %m "$STATE/decay-last" 2>/dev/null) || dl=0
    (( mt > dl )) && dl=$mt
    local rem=$(( dl + DECAY_SECS - now ))
    # decay pauses while the summary is mid-rebuild or the closer is
    # waiting on the layout lock — say so instead of freezing at 0:00
    if (( rem <= 0 )); then
        printf 'closing…'
    else
        printf 'closes in %d:%02d' $(( rem / 60 )) $(( rem % 60 ))
    fi
}

show_idle() {
    # OSC 0 sets the session name (what iTerm displays), not just the
    # window title
    printf '\033]0;· %s ·\007' "$N"
    printf '\033[H\033[2J\033[3J'
    printf '\n  \033[37m· slot %s idle ·\033[0m\n' "$N"
    idle_tick
}

# rewrite only the countdown line (row 3) so the ticking doesn't flicker
# the whole pane
idle_tick() {
    local c
    c="$(idle_line)"
    printf '\033[3;1H\033[K'
    [[ -n "$c" ]] && printf '  \033[33m%s\033[0m' "$c"
}

cleanup() {
    [[ -n "$tailpid" ]] && kill "$tailpid" 2>/dev/null
    exit 0
}
trap cleanup INT TERM HUP

while true; do
    # throttled so the 0.3s loop doesn't fork sed every pass
    if (( SECONDS - last_rev_check >= 5 )); then
        last_rev_check=$SECONDS
        # re-read so a conf edit lands on a running pane without a restart
        DECAY_SECS=$(tile_conf decay_secs 15)
        rev="$(src_rev)"
        if [[ -n "$rev" && "$rev" != "$REVISION" ]]; then
            [[ -n "$tailpid" ]] && kill "$tailpid" 2>/dev/null
            exec "$SELF" "$N"
        fi
    fi
    new=""
    [[ -s "$SLOTF" ]] && new=$(<"$SLOTF")
    if [[ "$new" != "$cur" ]]; then
        [[ -n "$tailpid" ]] && { kill "$tailpid" 2>/dev/null; wait "$tailpid" 2>/dev/null }
        tailpid=""
        cur="$new"
        if [[ -n "$cur" && -f "$cur" ]]; then
            # name the pane after the run's full command (log line 1
            # carries it in an OSC 2 escape)
            l1=$(head -1 "$cur" 2>/dev/null)
            t="${l1#*\]2;}"
            t="${t%%$'\a'*}"
            [[ -n "$t" && "$t" != "$l1" ]] || t="slot $N"
            printf '\033]0;%s\007' "$t"
            printf '\033[H\033[2J\033[3J'
            /usr/bin/tail -n +1 -F "$cur" 2>/dev/null &
            tailpid=$!
        else
            show_idle
            last_idle_tick=$SECONDS
        fi
    fi
    # keep the decay countdown ticking while idle
    if [[ -z "$cur" ]] && (( SECONDS - last_idle_tick >= 1 )); then
        last_idle_tick=$SECONDS
        idle_tick
    fi
    # q drops this pane to an interactive shell (watcher is gone until
    # the next grid rebuild)
    if [[ -t 0 ]]; then
        key=""
        read -s -t 0.3 -k 1 key 2>/dev/null
        if [[ "$key" == q ]]; then
            [[ -n "$tailpid" ]] && kill "$tailpid" 2>/dev/null
            printf '\033]1337;SetUserVar=cargotile=\007'
            printf '\033[H\033[2J\033[3J'
            exec /bin/zsh -il
        fi
    else
        sleep 0.3
    fi
done
