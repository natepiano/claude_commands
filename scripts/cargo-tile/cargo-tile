#!/bin/zsh
# rev 44 — bump this comment in every cargo-tile source file on each change
# Control command for cargo run tiling in iTerm2.
set -u

TILE_HOME="${CARGO_TILE_HOME:-$HOME/.cargo-tile}"
# hot state lives under /tmp so sandboxed callers can write it; the
# on/off toggle is $TILE_HOME/active so it survives reboots
STATE=/tmp/cargo-tile/state
ERRLOG=/tmp/cargo-tile/pane-errors.log
mkdir -p "$STATE"

# state moved out of ~/.cargo-tile at rev 33 — carry the window
# bookkeeping over once and drop the rest
if [[ -d "$TILE_HOME/state" ]]; then
    for f in window windows-created; do
        [[ -f "$TILE_HOME/state/$f" && ! -f "$STATE/$f" ]] && \
            cp "$TILE_HOME/state/$f" "$STATE/$f"
    done
    [[ -f "$TILE_HOME/state/active" ]] && touch "$TILE_HOME/active"
    rm -rf "$TILE_HOME/state"
fi

# clear the run list only — the window id and created-window history are
# kept so the next run reuses (or closes) existing grid windows instead
# of orphaning them
reset_layout() {
    rm -f "$STATE/session" "$STATE/count" "$STATE/runs" "$STATE/grid" "$STATE/next-slot" "$STATE/grid-since" "$STATE/retreat-pending" "$STATE/rebuild-needed" "$STATE/pre-last" "$STATE/layout" "$STATE/pane-seq" "$STATE/decay-last"
    rm -f "$STATE"/pids/*(N) "$STATE"/slots/*(N) "$STATE"/panemap/*(N)
    rmdir "$STATE/lock" 2>/dev/null
}

# install the shim over each rustup toolchain's cargo so hardcoded-path
# invocations (rust-analyzer, nextest, scripts) are captured too; the
# real binary moves to cargo-tile-real. Safe to rerun — a rustup update
# that replaces the wrapper is re-hooked on the next `cargo-tile on`.
hook_toolchains() {
    local shim="$TILE_HOME/bin/cargo" tc
    for tc in "$HOME"/.rustup/toolchains/*/bin(N); do
        [[ -e "$tc/cargo" ]] || continue
        if ! grep -q 'cargo-tile-shim' "$tc/cargo" 2>/dev/null; then
            mv -f "$tc/cargo" "$tc/cargo-tile-real" || continue
        fi
        cp -f "$shim" "$tc/cargo" && chmod +x "$tc/cargo"
        echo "  hooked ${tc:h:t}"
    done
}

unhook_toolchains() {
    local tc
    for tc in "$HOME"/.rustup/toolchains/*/bin(N); do
        if [[ -x "$tc/cargo-tile-real" ]]; then
            mv -f "$tc/cargo-tile-real" "$tc/cargo"
            echo "  unhooked ${tc:h:t}"
        fi
    done
}

# re-register shim runs that are still alive (their pid is in the log
# filename, their command and cwd in the log header) — so `on` mid-flight
# no longer orphans them
adopt_live_runs() {
    mkdir -p "$STATE/pids"
    local lg pid l1 title dir sub w n=0
    for lg in /tmp/cargo-tile/run-*-*.log(N); do
        pid="${${lg:t:r}##*-}"
        [[ "$pid" == <-> ]] || continue
        kill -0 "$pid" 2>/dev/null || continue
        [[ -f "$STATE/pids/$pid" ]] && continue
        # a finished run leaves the shim's exit banner — never adopt it:
        # overnight the pid gets reused, so kill -0 alone proves nothing
        if tail -2 "$lg" 2>/dev/null | grep -q -- '── exit '; then
            rm -f "$lg"
            continue
        fi
        # pid-reuse guard for runs that died without a banner: the live
        # process must actually be cargo
        ps -p "$pid" -o command= 2>/dev/null | grep -q cargo || continue
        # log line 1: OSC title "cargo <args>  [~/dir]" then the command echo
        l1=$(head -1 "$lg" 2>/dev/null)
        title="${l1#*\]2;}"
        title="${title%%$'\a'*}"
        dir="${${title##*\[}%\]}"
        # a title without "[~/dir]" (pre-rev-38 log) parses to the command
        # itself — no usable cwd, so skip rather than corrupt the summary
        [[ "$dir" == "~"* || "$dir" == /* ]] || continue
        sub=""
        for w in ${(z)${title%%  \[*}}; do
            [[ "$w" == cargo || "$w" == -* || "$w" == +* ]] && continue
            sub="$w"
            break
        done
        # same exclusions as the shim
        [[ "$sub" == port ]] && continue
        print -r -- "$dir	${title%%  \[*}" > "$STATE/pids/$pid"
        # the summary reads start time from the pid file's mtime; for an
        # adopted run that is the log's birth (in its filename:
        # run-YYYYmmdd-HHMMSS-pid), not adoption time
        local -a lparts
        lparts=(${(s.-.)${lg:t:r}})
        if (( ${#lparts} >= 3 )) && [[ "${lparts[2]}" == <-> && "${lparts[3]}" == <-> ]]; then
            touch -t "${lparts[2]}${lparts[3][1,4]}.${lparts[3][5,6]}" \
                "$STATE/pids/$pid" 2>/dev/null
        fi
        "$TILE_HOME/bin/cargo-tile-pane" "$lg" \
            >/dev/null 2>>"$ERRLOG"
        (( n += 1 ))
    done
    echo "  adopted live cargo runs: $n"
}

# snapshot cargo processes already running — they can't be captured, but
# the summary pane shows them until they exit
snapshot_preexisting() {
    : > "$STATE/preexisting"
    ps -axo pid=,command= 2>/dev/null | while read -r pid cmd; do
        tok="${cmd%% *}"
        [[ "$tok" == *cargo-tile* ]] && continue
        [[ "$tok" == *cargo-port* ]] && continue
        [[ "$tok" == cargo || "$tok" == */cargo ]] || continue
        # cargo port is untracked (see the shim's skip list)
        rest="${cmd#* }"
        [[ "$rest" == port || "$rest" == "port "* ]] && continue
        print -r -- "$pid	$cmd" >> "$STATE/preexisting"
    done
    local n
    n=$(grep -c . "$STATE/preexisting" 2>/dev/null)
    echo "  pre-existing cargo processes: ${n:-0}"
}

case "${1:-status}" in
    on)
        reset_layout
        hook_toolchains
        snapshot_preexisting
        touch "$TILE_HOME/active"
        adopt_live_runs
        # bring up the summary window even with nothing to adopt —
        # sandboxed runs rely on its pane to do their grid rebuilds
        "$TILE_HOME/bin/cargo-tile-pane" --check \
            >/dev/null 2>>"$ERRLOG" &!
        echo "cargo-tile: on — new cargo runs open panes in the grid window"
        ;;
    off)
        rm -f "$TILE_HOME/active"
        echo "cargo-tile: off"
        ;;
    reset)
        reset_layout
        echo "cargo-tile: layout reset"
        ;;
    hook)
        hook_toolchains
        ;;
    unhook)
        unhook_toolchains
        ;;
    status)
        if [[ -f "$TILE_HOME/active" ]]; then
            shape=""
            if [[ -s "$STATE/layout" ]]; then
                typeset -a lw
                while IFS= read -r lline; do
                    # split first: ${#${=x}} on a one-word line is its
                    # string length, not 1
                    lw=(${=lline})
                    shape+="${shape:+ + }${#lw}"
                done < "$STATE/layout"
            fi
            runs=0
            for sf in "$STATE"/slots/*(N); do
                [[ -s "$sf" ]] && (( runs += 1 ))
            done
            pre=0
            [[ -f "$STATE/preexisting" ]] && pre=$(grep -c . "$STATE/preexisting")
            echo "cargo-tile: on (panes ${shape:-none}, $runs runs tiled, $pre pre-existing)"
        else
            echo "cargo-tile: off"
        fi
        ;;
    *)
        echo "usage: cargo-tile [on|off|reset|status|hook|unhook]" >&2
        exit 2
        ;;
esac
