#!/usr/bin/env bash
# lint — public entry point over invoke.sh, the single bottom layer for cargo
# invocation policy. Shell aliases (clippy, cf, ct, cwb, mend), validate_ci.sh,
# pre_release_checks.sh, clean-fix agent prompts, and /clippy all come through
# here; delegate/verify.sh sources invoke.sh directly to add its per-package
# scope rules. This file picks workspace scope only, never policy flags.
set -euo pipefail

# shellcheck source=/dev/null
source "$HOME/.claude/scripts/lint/invoke.sh"

usage() {
  cat <<EOF
Usage:
  lint mend [args...]             cargo mend --workspace --all-targets
  lint clippy [args] [-- lints]   workspace clippy --all-targets, -D warnings
  lint clippy-tests [args] [-- lints]
                                  workspace clippy over lib/bins/tests only —
                                  validate_ci's host shape (no examples or
                                  benches)
  lint doc [args...]              cargo doc, warnings denied
  lint fmt [args...]              cargo +nightly fmt --all
  lint nextest [args...]          cargo nextest run

mend/clippy/doc/fmt honor config/lint.conf (edit with /lint_config);
LINT_CONFIG_FORCE=1 overrides the gate — push and release gates set it on
steps they never allow to skip. Extra args (--manifest-path, --fix, --target,
"-- <clippy lints>") pass through unchanged.
EOF
}

CMD="${1:-}"
[[ $# -gt 0 ]] && shift

case "$CMD" in
  mend)         invoke_mend "$@" ;;
  clippy)       invoke_clippy --workspace --all-targets --all-features "$@" ;;
  clippy-tests) invoke_clippy --workspace --all-features --tests "$@" ;;
  doc)          invoke_doc "$@" ;;
  fmt)          fmt_cargo --all "$@" ;;
  nextest)      run_nextest "$@" ;;
  --help|-h)    usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
