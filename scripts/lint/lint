#!/usr/bin/env bash
# lint — public entry point over invoke.sh, the single bottom layer for cargo
# invocation policy. Shell aliases (clippy, cf, ct, cwb, mend), validate_ci.sh,
# pre_release_checks.sh, fix pipeline agent prompts, and /clippy all come through
# here; delegate/verify.sh sources invoke.sh directly to add its per-package
# scope rules. This file picks workspace scope only, never policy flags.
set -euo pipefail

# shellcheck source=/dev/null
source "$HOME/.claude/scripts/lint/invoke.sh"

usage() {
  cat <<EOF
Usage:
  lint mend [args...]             cargo mend --all-targets
  lint clippy [args] [-- lints]   clippy --all-targets, -D warnings; with no
                                  args and a clippy-linked cargo-mend, the
                                  read-only \`lint mend\` run answers for it
  lint clippy-tests [args] [-- lints]
                                  clippy over lib/bins/tests only —
                                  validate_ci's host shape (no examples or
                                  benches)
  lint doc [args...]              cargo doc, warnings denied
  lint fmt [args...]              cargo +nightly fmt --all
  lint nextest [args...]          cargo nextest run
  lint sweep [--dry-run]          hold the target directory under a size budget
                                  (cargo-port's last lint command)

Scope is resolved per run: in a workspace with more than one member, mend,
clippy, clippy-tests, doc, and nextest cover --workspace; a single-crate
project gets no scope flags. Features are the default set unless the caller
passes its own (the push gate passes --all-features). One package selection
and one feature set for every run is what lets them all share one compiled
dependency tree. Pass --workspace or -p <pkg> to choose the scope yourself and
skip resolution. --manifest-path does NOT skip resolution: it names a
manifest, not a package set, so resolution runs against that manifest's tree
instead of the working directory. fmt is always --all: it
compiles nothing, so the wider scope is free. sweep takes no scope either: it
removes the least recently used build output from the target directory of the
workspace in the current directory, cargo-port's cwd, until it fits the
budget: LINT_SWEEP_BUDGET_GIB if set, else sweep_budget_gib.<repo> or
sweep_budget_gib in config/lint.conf (24 GiB, hana 96), and runs last in each
of cargo-port's lint runs.

mend/clippy/doc/fmt/sweep honor config/lint.conf (edit with /lint_config);
LINT_CONFIG_FORCE=1 overrides the gate — push and release gates set it on
steps they never allow to skip. Extra args (--manifest-path, --fix, --target,
"-- <clippy lints>") pass through unchanged.
EOF
}


# Package scope. Every run covers the whole workspace: cargo resolves features
# from the selected packages, so narrowing to the members the working tree
# changed gave each member set its own feature resolution and its own compiled
# copy of the dependency tree, and those copies evicted one another. With one
# selection, an unchanged member is a fingerprint check, not a recompile. It
# stays out of the way when the caller already picked a PACKAGE scope --
# --workspace from a gate, or -p from a targeted run.
#
# --manifest-path is deliberately not in that list, though it used to be. It
# names a manifest, not a package set: aimed at a virtual workspace root it
# leaves cargo selecting every member, so short-circuiting on it made each
# per-project driver that passes it -- cargo-port's lint commands, the fix pipeline's
# agent prompts -- silently lint the whole workspace, with no --workspace in
# the argv to reveal it. The full argv goes to scope.py instead, which reads
# the manifest path out of it and resolves against that tree.
lint_scope() {
    local arg
    for arg in "$@"; do
        case "$arg" in
            --workspace | --all | -p | --package | -p=* | --package=*)
                return 0
                ;;
        esac
    done
    python3 "$HOME/.claude/scripts/lint/scope.py" "$@"
}

# Populate the SCOPE array from lint_scope. macOS ships bash 3.2, which has no
# `mapfile`, so a read loop stands in for it -- and must, because the shebang
# resolves to that system bash whenever no newer one is on PATH. cargo-port runs
# with a bare PATH, so a `mapfile` here fails with exit 127 and the lint never
# runs at all.
resolve_scope() {
    SCOPE=()
    local line
    while IFS= read -r line; do
        [[ -n "$line" ]] && SCOPE+=("$line")
    done < <(lint_scope "$@")
}

# A clippy-linked cargo-mend (invoke.sh, mend_clippy_probe) runs clippy's
# lints inside its own compile. An argument-free `lint clippy`, the call
# port-lint and /clippy make, then runs the read-only `lint mend` instead of
# stock clippy: the same argv, so the two share cargo's cache, and whichever
# runs second is a cache replay. Any argument keeps stock clippy: it asks for
# what mend cannot do (extra lints, --fix) or parts from `lint mend`'s argv
# and so from its cache. The push gate (validate_ci.sh) passes --workspace
# --all-features, so stock clippy stays its final authority. mend=off in
# lint.conf keeps stock clippy too.
mend_covers_clippy() {
    lint_config_enabled clippy && lint_config_enabled mend || return 1
    mend_clippy_probe
    [[ "$MEND_CLIPPY_STATE" == active ]]
}

# clippy_in_mend SCOPE...: `cargo clippy --all-targets -- -D warnings`,
# answered by mend. It fails where that fails: mend failed (a compile error, a
# denied lint), or its report counts a compiler warning, clippy's included,
# which -D warnings makes an error; 101 is cargo's status for a failed
# compile. A report with no count runs stock clippy. On a terminal, cargo
# keeps its colors through the tee: CARGO_TERM_COLOR leaves the build cache
# alone.
clippy_in_mend() {
    local log status=0 warnings
    log="$(mktemp)"
    if [[ -t 1 && -z "${CARGO_TERM_COLOR:-}" ]]; then
        export CARGO_TERM_COLOR=always
    fi
    invoke_mend "$@" 2>&1 | tee "$log" || status=$?
    warnings="$(mend_clippy_warnings "$log")" || warnings=""
    rm -f "$log"
    if [[ $status -ne 0 ]]; then
        return $status
    fi
    if [[ -z "$warnings" ]]; then
        echo "lint: cargo mend's report shows no warning count; running stock clippy"
        invoke_clippy "$@" --all-targets
    elif [[ "$warnings" -gt 0 ]]; then
        echo "lint: clippy denies warnings, and cargo mend's compile left $warnings, clippy's lints included" >&2
        return 101
    else
        echo "lint: clippy ran inside cargo mend's compile and left no warnings"
    fi
}

CMD="${1:-}"
[[ $# -gt 0 ]] && shift

case "$CMD" in
  mend)         resolve_scope "$@"
                invoke_mend ${SCOPE[@]+"${SCOPE[@]}"} "$@" ;;
  clippy)       resolve_scope "$@"
                if [[ $# -eq 0 ]] && mend_covers_clippy; then
                    clippy_in_mend ${SCOPE[@]+"${SCOPE[@]}"}
                else
                    invoke_clippy ${SCOPE[@]+"${SCOPE[@]}"} --all-targets "$@"
                fi ;;
  clippy-tests) resolve_scope "$@"
                invoke_clippy ${SCOPE[@]+"${SCOPE[@]}"} --tests "$@" ;;
  doc)          resolve_scope "$@"
                invoke_doc ${SCOPE[@]+"${SCOPE[@]}"} "$@" ;;
  fmt)          fmt_cargo --all "$@" ;;
  nextest)      resolve_scope "$@"
                run_nextest ${SCOPE[@]+"${SCOPE[@]}"} "$@" ;;
  sweep)        invoke_sweep "$@" ;;
  --help|-h)    usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
