{
  "venvPath": ".",
  "venv": ".venv",
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.*",
    "plugins",
    "jobs"
  ],
  "executionEnvironments": [
    {
      "root": "scripts/model_study",
      "extraPaths": [
        "scripts/model_study"
      ]
    },
    {
      "root": "scripts/hooks",
      "extraPaths": [
        "scripts/hooks"
      ]
    },
    {
      "root": "scripts/fix",
      "extraPaths": [
        "scripts/fix"
      ]
    },
    {
      "root": "scripts/whoami",
      "extraPaths": [
        "scripts/whoami"
      ]
    },
    {
      "root": "scripts/nightly_review",
      "extraPaths": [
        "scripts/nightly_review",
        "scripts/whoami"
      ]
    },
    {
      "root": "scripts/message",
      "extraPaths": [
        "scripts/message"
      ]
    },
    {
      "root": "scripts/banned_word_analysis",
      "extraPaths": [
        "scripts/banned_word_analysis",
        "scripts/hooks"
      ]
    },
    {
      "root": "scripts/buildlog",
      "extraPaths": [
        "scripts/buildlog",
        "scripts/lint"
      ]
    },
    {
      "root": "scripts/lint",
      "extraPaths": [
        "scripts/lint"
      ]
    },
    {
      "root": "scripts/notify",
      "extraPaths": [
        "scripts/notify"
      ]
    },
    {
      "root": "scripts/production",
      "extraPaths": [
        "scripts/production",
        "scripts/build_hold",
        "scripts/whoami"
      ]
    },
    {
      "root": "scripts/build_hold",
      "extraPaths": [
        "scripts/build_hold"
      ]
    },
    {
      "root": "."
    }
  ]
}
