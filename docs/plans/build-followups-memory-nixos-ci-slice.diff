# CI is killed at its ceiling, never stalled below it (build-followups-memory, Phase 3)
#
# Against /etc/nixos e669461. hana-ci.slice's MemoryHigh 10G throttled both
# Linux jobs of CI 37227844227 attempt 3 (slice at 10.8G, swap at its 2G cap,
# memory pressure some avg10=93 full avg10=91, memory.events high=5.67M) until
# GitHub dropped both runners at 13:56 PDT: Runner.Listener runs in the same
# cgroup and reclaim starved its heartbeat. This removes MemoryHigh, so the
# slice runs unthrottled up to MemoryMax 18G (swap cap 2G kept), where the
# kernel kills the largest process in the slice. The runners get
# OOMPolicy=continue: the default, stop, would turn that one kill into
# stopping the whole runner, listener included, which loses the job just the
# same.
#
# The rebuild restarts both runners (their unit changes): pick a time with no
# CI job running. It also ends the leftover job processes still in the slice.
# After the rebuild:
#   systemctl show hana-ci.slice -p MemoryHigh -p MemoryMax -p MemorySwapMax
#                    # MemoryHigh=infinity, MemoryMax=19327352832, MemorySwapMax=2147483648
#   systemctl show github-runner-hana-linux-1 github-runner-hana-linux-2 -p OOMPolicy
#                    # continue, twice
--- a/modules/linux/hana-runners.nix
+++ b/modules/linux/hana-runners.nix
@@ -550,6 +550,9 @@
 
       serviceOverrides = {
         Slice = "${sliceName}.slice";
+        # A kernel kill at the slice's MemoryMax takes one compiler. The default
+        # OOMPolicy=stop would then stop the whole runner, its listener too.
+        OOMPolicy = "continue";
         # PrivateDevices hides the host device and DevicePolicy blocks it even
         # after binding, so both grants are needed for the jobserver.
         DeviceAllow = [ "char-rtc r" "/dev/steve rw" ];
@@ -605,8 +608,13 @@
 
   # THE AGGREGATE BUDGET. CI and sessions share steve's slots, but a compiler
   # can grow after admission. Bevy task pools and nested jobs also consume
-  # memory outside cargo's slot accounting. This slice holds both CI runners:
-  # reclaim starts at 10G, and 18G is the hard ceiling. The former 40G cap was
+  # memory outside cargo's slot accounting. This slice holds both CI runners,
+  # and 18G is the hard ceiling with nothing below it that throttles. A
+  # MemoryHigh of 10G stalled both jobs at memory pressure 90% until GitHub
+  # dropped the runners (run 37227844227, 13:56 PDT 2026-10-04): each
+  # Runner.Listener sits in this slice, and reclaim starved its heartbeat. At
+  # the ceiling the kernel kills the largest process, a compiler, and the job
+  # fails with an error instead of vanishing. The former 40G cap was
   # mostly page cache, but both CI builds were killed by earlyoom on
   # 2026-10-04 while the two admission systems could not see each other.
   #
@@ -619,7 +627,6 @@
     description = "hana CI runners, aggregate CPU and memory budget";
     sliceConfig = {
       CPUQuota = "2400%";
-      MemoryHigh = "10G";
       MemoryMax = "18G";
       # MemoryMax counts RAM only. MemorySwapMax bounds swapped pages; zram
       # stores them at about a third of their size with zstd, outside the
