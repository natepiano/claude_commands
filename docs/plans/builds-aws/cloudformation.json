          ]
        },
        "State": "ENABLED",
        "Targets": [
          {
            "Arn": {
              "Fn::GetAtt": [
                "GateExpiryFunction",
                "Arn"
              ]
            },
            "Id": "GateExpiry"
          }
        ],
        "Name": {
          "Fn::Sub": "cloud-claude-gate-${DeploymentId}-expiry"
        }
      }
