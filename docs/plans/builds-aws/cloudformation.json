    "GateExpiryFunction": {
      "Type": "AWS::Lambda::Function",
      "Condition": "Gates",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "cloud-claude-gate-${DeploymentId}-expiry"
        },
        "Runtime": "python3.13",
        "Handler": "index.handler",
        "Role": {
          "Fn::GetAtt": [
            "GateExpiryRole",
            "Arn"
          ]
        },
        "Timeout": {
          "Ref": "GateExpiryTimeout"
        },
        "MemorySize": {
          "Ref": "GateExpiryMemory"
        },
        "Environment": {
          "Variables": {
            "DEPLOYMENT": {
              "Ref": "DeploymentId"
            }
          }
        },
        "Code": {
          "ZipFile": "import os, time, boto3\n\ndef handler(event, context):\n    ec2 = boto3.client('ec2')\n    filters = [{'Name': 'tag:GateDeployment', 'Values': [os.environ['DEPLOYMENT']]},\n               {'Name': 'tag:Workload', 'Values': ['cloud-claude-gate']},\n               {'Name': 'instance-state-name', 'Values': ['pending', 'running', 'stopping', 'stopped']}]\n    for page in ec2.get_paginator('describe_instances').paginate(Filters=filters):\n        for group in page['Reservations']:\n            for instance in group['Instances']:\n                tags = {tag['Key']: tag['Value'] for tag in instance.get('Tags', [])}\n                try:\n                    expired = int(tags['ExpiresAt']) <= time.time()\n                except (KeyError, ValueError):\n                    expired = False\n                if expired:\n                    ec2.terminate_instances(InstanceIds=[instance['InstanceId']])\n"
        },
        "Tags": [
          {
            "Key": "Workload",
            "Value": "cloud-claude-gate"
          },
          {
            "Key": "Name",
            "Value": "cloud-claude-gate"
          }
        ]
      },
      "DependsOn": "GateExpiryLog"
    },
    "GateExpiryLog": {
      "Type": "AWS::Logs::LogGroup",
      "Condition": "Gates",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/cloud-claude-gate-${DeploymentId}-expiry"
        },
        "RetentionInDays": {
          "Ref": "GateLogDays"
        },
        "Tags": [
          {
            "Key": "Workload",
            "Value": "cloud-claude-gate"
          },
          {
            "Key": "Name",
            "Value": "cloud-claude-gate"
          }
        ]
      }
    },
    "GateExpirySchedule": {
      "Type": "AWS::Events::Rule",
      "Condition": "Gates",
      "Properties": {
        "ScheduleExpression": {
          "Fn::If": [
            "GateEveryMinute",
            "rate(1 minute)",
            {
