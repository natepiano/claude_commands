# Ignore everything
*

# Allow what we track
!.gitignore
!.gitattributes
!CLAUDE.md
!README.md
!settings.json
!settings.local.json
!pyrightconfig.json
!keybindings.json
!.claude/
!.claude/settings.local.json
!commands/
!commands/**
!config/
!config/**
/config/showrunners.json
/config/showrunners.lock
/config/accounts.json
/config/accounts.lock
# This machine's agent rows over config/agents.conf (scripts/agents/agents_overlay.sh).
/config/agents.local.conf
/config/agents.local.conf.*
/config/agents.conf.*
!docs/
!docs/**
!scripts/
!scripts/**
!shared/
!shared/**
!templates/
!templates/**
!mods/
!mods/**
mods/**/.claude-plugin/types/
# Python cache (inside allowed dirs)
**/__pycache__/
