{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "claude-code": ["./.claude-plugin/types/claude-code/index.d.ts"]
    }
  },
  "include": ["hooks/**/*.ts"]
}
